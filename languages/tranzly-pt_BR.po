msgstr "Tokens de entrada / saída"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
#: src/admin/About.js:15
msgid "About"
msgstr "Sobre"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
#: includes/freemius-strings.php:2177
#: includes/freemius-strings.php:5037
msgid "Result"
