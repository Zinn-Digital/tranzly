msgstr "దీని కోసం ఉపయోగించబడుతుంది"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
msgid "Model"
msgstr "మోడల్"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
msgid "Tokens in / out"
