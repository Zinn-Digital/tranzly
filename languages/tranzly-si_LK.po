#: src/admin/WorkflowTab.js:469
msgid "XLIFF 1.2 (translation tools)"
msgstr "XLIFF 1.2 (පරිවර්තන මෙවලම්)"

#: src/admin/WorkflowTab.js:473
msgid "CSV (spreadsheets)"
msgstr "CSV (පැතිරුණු පත්ර)"

#: src/admin/WorkflowTab.js:480
