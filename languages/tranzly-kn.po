#: src/admin/App.js:217
msgid "This site receives beta versions as updates."
msgstr "ಈ ಸೈಟ್ ನವೀಕರಣಗಳಾಗಿ ಬೀಟಾ ಆವೃತ್ತಿಗಳನ್ನು ಪಡೆಯುತ್ತದೆ."

#: src/admin/App.js:221
msgid "This site receives stable versions only."
msgstr "ಈ ಸೈಟ್ ಸ್ಥಿರ ಆವೃತ್ತಿಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ."

#: src/admin/App.js:230
msgid "Change this on the Account page"
msgstr "ಇದನ್ನು ಖಾತೆ ಪುಟದಲ್ಲಿ ಬದಲಾಯಿಸಿ"

#: src/admin/App.js:239
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "ಬೀಟಾ ಆವೃತ್ತಿಗಳನ್ನು ತಮ್ಮ ಖಾತೆಗೆ ಸಂಪರ್ಕಗೊಂಡಿರುವ ಪರವಾನಗಿ ಪಡೆದ ಪ್ರೊ ಅನುಸ್ಥಾಪನೆಗಳಿಗೆ ನೀಡಲಾಗುತ್ತದೆ. ಒಮ್ಮೆ ಸಂಪರ್ಕಗೊಂಡ ನಂತರ, ನೀವು ಖಾತೆ ಪುಟದಿಂದ ಸೇರಬಹುದು."

#: src/admin/App.js:255
msgid "Save settings"
msgstr "ಸಂಯೋಜನೆಗಳನ್ನು ಉಳಿಸಿ"

#: src/editor/index.js:17
msgid "Add a second language under Tranzly in the admin menu, and the switcher appears here."
msgstr "ನಿರ್ವಹಣಾ ಮೆನುಡಿನಲ್ಲಿ Tranzly ಅಡಿಯಲ್ಲಿ ಎರಡನೇ ಭಾಷೆಯನ್ನು ಸೇರಿಸಿ, ಮತ್ತು ಸ್ವಿಚ್ಚರ್ ಇಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ."

#: src/editor/index.js:29
msgid "Switcher"
msgstr "ಸ್ವಿಚರ್"

#: src/editor/index.js:32
msgid "Accessible label"
msgstr "ಪ್ರವೇಶಿಸಬಹುದಾದ ಲೇಬಲ್"

#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "ಭಾಷಾ ಬದಲಾಯಿಸುವ ಸಾಧನ"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "ಸೈಟ್‌ನ ಪ್ರತಿಯೊಂದು ಭಾಷೆಯಲ್ಲಿಯೂ ಈ ಪುಟಕ್ಕೆ ಲಿಂಕ್‌ಗಳು. ಎರಡೋ ಅಥವಾ ಹೆಚ್ಚಿನ ಭಾಷೆಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುವವರೆಗೆ ಇದು ಏನನ್ನೂ ಪ್ರದರ್ಶಿಸುವುದಿಲ್ಲ."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ಭಾಷೆ"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "ಸ್ವಿಚರ್"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "ಅನುವಾದ"
