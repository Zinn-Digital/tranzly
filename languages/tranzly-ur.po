msgstr "وہ آئٹم کسی ٹرانسلیشن جاب کا حصہ نہیں ہے۔"

#: includes/core/class-queue.php:398
#: includes/core/class-translator.php:86
msgid "You are not allowed to change that translation."
msgstr "آپ کو اس ترجمے کو تبدیل کرنے کی اجازت نہیں ہے۔"

#. translators: 1: language code, 2: the ID of the item that already has it.
#: includes/core/class-relations.php:176
#: includes/core/class-relations.php:230
#, php-format
msgid "This item's group already has a %1$s version (#%2$d)."
msgstr "اس عنصر کے گروپ میں پہلے سے ہی %1$s ورژن (#%2$d) موجود ہے۔"

#: includes/core/class-relations.php:208
msgid "An item cannot be its own translation."
msgstr "ایک شے خود اپنی ترجمہ نہیں ہو سکتی۔"

#: includes/core/class-relations.php:239
msgid "That item is already a translation of something else. Unlink it first."
