msgstr "Додайте другу мову в меню адміністратора в розділі Tranzly, і перемикач з'явиться тут."

#: src/editor/switcher.js:67
msgid "Off by default: a flag is a country, not a language."
msgstr "Вимкнено за замовчуванням: прапор — це країна, а не мова."

#: src/editor/switcher.js:108
msgid "What screen readers announce, for example “Choose a language”."
msgstr "Те, що озвучують екраночитачі, наприклад «Виберіть мову»."

#: src/editor/switcher.js:117
msgid "Colours"
msgstr "Кольори"

#: src/editor/translations-model.js:26
msgid "Not translated"
msgstr "Не перекладено"

#: src/editor/translations-model.js:29
msgid "Original"
msgstr "Оригінал"

#: src/editor/translations-model.js:33
msgid "Published"
msgstr "Опубліковано"

#: src/editor/translations-model.js:34
msgid "Draft"
msgstr "Чернетка"

#: src/editor/translations-model.js:36
msgid "Checked by a person, protected"
msgstr "Перевірено людиною, захищено"

#: src/editor/translations-model.js:37
