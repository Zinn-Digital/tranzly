msgstr "ዝርዝሩን መጫን አልተቻለም።"

#: src/admin-kit/Support.js:709
msgid "That login could not be removed."
msgstr "ይህ መግቢያ ሊወገድ አልቻለም።"

#: src/admin-kit/Support.js:721
msgid "Temporary support logins"
msgstr "ጊዜያዊ የድጋፍ መግቢያዎች"

#: src/admin-kit/Support.js:733
msgid "None. Support can only log in to this site if you create a login here."
msgstr "ምንም። እዚህ መግቢያ (login) ከፈጠሩ ብቻ ድጋፍ ሰጪ ቡድኑ ወደዚህ ጣቢያ መግባት ይችላል።"

#: src/admin-kit/Support.js:745
msgid "expired, being removed"
msgstr "ጊዜው ያለፈበት፣ እየተወገደ ነው"

