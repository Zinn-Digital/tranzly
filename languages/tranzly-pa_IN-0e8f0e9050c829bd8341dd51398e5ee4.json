    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "pa_IN",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Engine for %s": [
                "%s \u0a32\u0a08 \u0a07\u0a70\u0a1c\u0a23"
            ],
            "The default engine": [
                "\u0a2e\u0a42\u0a32 \u0a07\u0a70\u0a1c\u0a28"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u0a1c\u0a47 \u0a15\u0a4b\u0a08 \u0a07\u0a70\u0a1c\u0a23 \u0a05\u0a38\u0a2b\u0a32 \u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a48 \u0a1c\u0a3e\u0a02 \u0a38\u0a40\u0a2e\u0a3e '\u0a24\u0a47 \u0a2a\u0a39\u0a41\u0a70\u0a1a\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a07\u0a38 \u0a15\u0a4d\u0a30\u0a2e \u0a35\u0a3f\u0a71\u0a1a \u0a05\u0a17\u0a32\u0a3f\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a05\u0a1c\u0a3c\u0a2e\u0a3e\u0a13"
            ],
            "Monthly spending caps": [
                "\u0a2e\u0a39\u0a40\u0a28\u0a3e\u0a35\u0a3e\u0a30 \u0a16\u0a30\u0a1a \u0a38\u0a40\u0a2e\u0a3e\u0a35\u0a3e\u0a02"
            ],
            "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap.": [
                "\u0a1c\u0a26\u0a4b\u0a02 \u0a15\u0a4b\u0a08 \u0a07\u0a70\u0a1c\u0a28 \u0a06\u0a2a\u0a23\u0a40 \u0a38\u0a40\u0a2e\u0a3e '\u0a24\u0a47 \u0a2a\u0a39\u0a41\u0a70\u0a1a \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a39\u0a48, \u0a24\u0a3e\u0a02 \u0a05\u0a17\u0a32\u0a47 \u0a2e\u0a39\u0a40\u0a28\u0a47 \u0a24\u0a71\u0a15 \u0a09\u0a38 \u0a28\u0a42\u0a70 \u0a39\u0a4b\u0a30 \u0a15\u0a41\u0a1d \u0a28\u0a39\u0a40\u0a02 \u0a2d\u0a47\u0a1c\u0a3f\u0a06 \u0a1c\u0a3e\u0a02\u0a26\u0a3e \u0a05\u0a24\u0a47 \u0a05\u0a38\u0a2b\u0a3c\u0a32 \u0a05\u0a28\u0a41\u0a35\u0a3e\u0a26 \u0a30\u0a3f\u0a2a\u0a4b\u0a30\u0a1f \u0a07\u0a38 \u0a26\u0a3e \u0a15\u0a3e\u0a30\u0a28 \u0a26\u0a71\u0a38\u0a26\u0a40 \u0a39\u0a48\u0964 \u0a2c\u0a3f\u0a28\u0a3e\u0a02 \u0a38\u0a40\u0a2e\u0a3e \u0a26\u0a47 \u0a30\u0a71\u0a16\u0a23 \u0a32\u0a08 \u0a16\u0a3e\u0a32\u0a40 \u0a1b\u0a71\u0a21\u0a4b\u0964"
            ],
            "%1$s (spent this month: $%2$s)": [
                "%1$s (\u0a07\u0a38 \u0a2e\u0a39\u0a40\u0a28\u0a47 \u0a16\u0a30\u0a1a \u0a15\u0a40\u0a24\u0a47: $%2$s)"
            ],
            "Save caps": [
                "\u0a38\u0a2e\u0a30\u0a71\u0a25\u0a3e\u0a35\u0a3e\u0a02 \u0a38\u0a70\u0a2d\u0a3e\u0a32\u0a4b"
            ],
            "Preferred translations (one per line: term = translation)": [
                "\u0a24\u0a30\u0a1c\u0a40\u0a39\u0a40 \u0a05\u0a28\u0a41\u0a35\u0a3e\u0a26 (\u0a2a\u0a4d\u0a30\u0a24\u0a40 \u0a32\u0a3e\u0a08\u0a28 \u0a07\u0a71\u0a15: \u0a38\u0a3c\u0a2c\u0a26 = \u0a05\u0a28\u0a41\u0a35\u0a3e\u0a26)"
            ],
            "Formality": [
                "\u0a30\u0a38\u0a2e\u0a40\u0a05\u0a24"
            ],
            "Default": [
                "\u0a2e\u0a42\u0a32"
            ],
            "Formal": [
                "\u0a30\u0a38\u0a2e\u0a40"
            ],
            "Informal": [
                "\u0a17\u0a3c\u0a48\u0a30-\u0a30\u0a38\u0a2e\u0a40"
            ],
            "Style instructions (audience, brand voice)": [
                "\u0a38\u0a3c\u0a48\u0a32\u0a40 \u0a28\u0a3f\u0a30\u0a26\u0a47\u0a38\u0a3c (\u0a26\u0a30\u0a38\u0a3c\u0a15, \u0a2c\u0a4d\u0a30\u0a3e\u0a02\u0a21 \u0a26\u0a40 \u0a06\u0a35\u0a3e\u0a1c\u0a3c)"
            ]
        }
    }
}
