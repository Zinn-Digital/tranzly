            ],
            "Add language": [
                "\u0632\u0628\u0627\u0646 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba"
            ],
            "Front-end output": [
                "\u0633\u0627\u0645\u0646\u06d2 \u06a9\u0627 \u0622\u0624\u0679 \u067e\u0679"
            ],
            "Class name prefix": [
                "\u06a9\u0644\u0627\u0633 \u06a9\u06d2 \u0646\u0627\u0645 \u06a9\u0627 \u067e\u0631\u06cc\u0641\u06a9\u0633"
            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u067e\u0644\u06af \u0627\u0646 \u0622\u067e \u06a9\u06d2 \u0635\u0641\u062d\u0627\u062a \u067e\u0631 \u062c\u0648 \u0628\u06be\u06cc \u06a9\u0644\u0627\u0633 \u06a9\u0627 \u0646\u0627\u0645 \u067e\u0631\u0646\u0679 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0648\u06c1 \u0627\u0633 \u067e\u0631\u06cc\u0641\u06a9\u0633 \u0633\u06d2 \u0634\u0631\u0648\u0639 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u060c \u062a\u0627\u06a9\u06c1 \u0635\u0641\u062d\u0627\u062a \u0633\u06d2 \u06cc\u06c1 \u0638\u0627\u06c1\u0631 \u0646\u06c1 \u06c1\u0648 \u06a9\u06c1 \u0627\u0646\u06c1\u06cc\u06ba \u06a9\u0633 \u067e\u0644\u06af \u0627\u0646 \u0646\u06d2 \u0628\u0646\u0627\u06cc\u0627 \u06c1\u06d2\u06d4 1 \u0633\u06d2 8 \u0686\u06be\u0648\u0679\u06d2 \u062d\u0631\u0648\u0641 \u06cc\u0627 \u06c1\u0646\u062f\u0633\u06d2\u060c \u062c\u0648 \u06a9\u0633\u06cc \u062d\u0631\u0641 \u0633\u06d2 \u0634\u0631\u0648\u0639 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"
            ],
            "Beta updates": [
                "\u0628\u06cc\u0679\u0627 \u0627\u067e \u0688\u06cc\u0679\u0633"
            ],
            "This site receives beta versions as updates.": [
                "\u06cc\u06c1 \u0633\u0627\u0626\u06cc\u0688 \u0627\u067e \u0688\u06cc\u0679\u0633 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0628\u06cc\u0679\u0627 \u0648\u0631\u0698\u0646\u0632 \u0648\u0635\u0648\u0644 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u06d4"
            ],
            "This site receives stable versions only.": [
                "\u0627\u0633 \u0633\u0627\u0626\u0679 \u067e\u0631 \u0635\u0631\u0641 \u0645\u0633\u062a\u062d\u06a9\u0645 \u0648\u0631\u0698\u0646\u0632 \u0645\u0648\u0635\u0648\u0644 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"
            ],
            "Change this on the Account page": [
                "\u0627\u0633\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06d2 \u0635\u0641\u062d\u06d2 \u067e\u0631 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u06cc\u06ba"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u0628\u06cc\u0679\u0627 \u0648\u0631\u0698\u0646 \u0644\u0627\u0626\u0633\u0646\u0633 \u06cc\u0627\u0641\u062a\u06c1 \u067e\u0631\u0648 \u0627\u0646\u0633\u0679\u0627\u0644\u06cc\u0634\u0646\u0632 \u06a9\u0648 \u067e\u06cc\u0634 \u06a9\u06cc\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u0646 \u06a9\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u0633\u06d2 \u0645\u0646\u0633\u0644\u06a9 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0645\u0646\u0633\u0644\u06a9 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u0622\u067e \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06d2 \u0635\u0641\u062d\u06d2 \u0633\u06d2 \u0634\u0627\u0645\u0644 \u06c1\u0648 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"
            ],
            "Save settings": [
                "\u0633\u06cc\u0679\u0646\u06af\u0632 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba"
            ],
            "First engine that is set up": [
                "\u067e\u06c1\u0644\u0627 \u0627\u0646\u062c\u0646 \u062c\u0648 \u0633\u06cc\u0679 \u0627\u067e \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2"
            ],
            "Key saved. It is stored encrypted and never shown again.": [
                "\u06a9\u0646\u062c\u06cc \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631 \u0644\u06cc \u06af\u0626\u06cc\u06d4 \u0627\u0633\u06d2 \u062e\u0641\u06cc\u06c1 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u0645\u062d\u0641\u0648\u0638 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u062f\u06a9\u06be\u0627\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"
            ],
            "Engine settings saved.": [
                "\u0627\u0646\u062c\u0646 \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af\u0632 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631 \u062f\u06cc \u06af\u0626\u06cc \u06c1\u06cc\u06ba\u06d4"
            ],
            "Glossary saved.": [
                "\u0644\u063a\u062a \u0645\u062d\u0641\u0648\u0638 \u06c1\u0648 \u06af\u0626\u06cc\u06d4"
            ],
            "Your keys": [
                "\u0622\u067e \u06a9\u06cc \u06a9\u0646\u062c\u06cc\u0627\u06ba"
            ],
            "Tranzly calls the translation services with your own account. Keys are stored encrypted in your database and are only ever sent to the service they belong to. AI model keys are set in the AI settings.": [
                "Tranzly \u062a\u0631\u062c\u0645\u06d2 \u06a9\u06cc \u062e\u062f\u0645\u0627\u062a \u06a9\u0648 \u0622\u067e \u06a9\u06d2 \u0627\u067e\u0646\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u06a9\u0627\u0644 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u06a9\u06cc\u0632 (Keys) \u0622\u067e \u06a9\u06d2 \u0688\u06cc\u0679\u0627 \u0628\u06cc\u0633 \u0645\u06cc\u06ba \u0627\u0646\u06a9\u0631\u067e\u0679 \u06a9\u0631 \u06a9\u06d2 \u0645\u062d\u0641\u0648\u0638 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u06cc\u06c1 \u0635\u0631\u0641 \u0627\u0633\u06cc \u0633\u0631\u0648\u0633 \u06a9\u0648 \u0628\u06be\u06cc\u062c\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u062c\u0633 \u0633\u06d2 \u0627\u0646 \u06a9\u0627 \u062a\u0639\u0644\u0642 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4 AI \u0645\u0627\u0688\u0644 \u06a9\u06cc\u0632 AI \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0645\u06cc\u06ba \u0633\u06cc\u0679 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4"
            ],
            "%s API key": [
                "%s API \u06a9\u06cc"
            ],
            "Saved: %s. Enter a new key to replace it, or save an empty field to remove it.": [
                "\u0645\u062d\u0641\u0648\u0638 \u06a9\u0631 \u0644\u06cc\u0627 \u06af\u06cc\u0627: %s\u06d4 \u0627\u0633\u06d2 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0646\u0626\u06cc \u06a9\u0644\u06cc\u062f \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u0633\u06d2 \u06c1\u0679\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0627\u0644\u06cc \u0641\u06cc\u0644\u0688 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "No key saved.": [
                "\u06a9\u0648\u0626\u06cc \u06a9\u0644\u06cc\u062f \u0645\u062d\u0641\u0648\u0638 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"
            ],
            "Azure region (leave empty for a global resource)": [
                "Azure \u062e\u0637\u06c1 (\u0639\u0627\u0644\u0645\u06cc \u0648\u0633\u0627\u0626\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0627\u0644\u06cc \u0686\u06be\u0648\u0691\u06cc\u06ba)"
            ],
            "Save key": [
                "\u06a9\u0644\u06cc\u062f \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba"
            ],
            "Check my DeepL usage": [
                "DeepL \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0648 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba"
            ],
            "%1$s of %2$s characters used this billing period.": [
                "\u0627\u0633 \u0628\u0644\u0646\u06af \u06a9\u06cc \u0645\u062f\u062a \u0645\u06cc\u06ba %2$s \u0645\u06cc\u06ba \u0633\u06d2 %1$s \u062d\u0631\u0648\u0641 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648 \u0686\u06a9\u06d2 \u06c1\u06cc\u06ba\u06d4"
            ],
            "Which engine translates": [
                "\u06a9\u0648\u0646 \u0633\u0627 \u0627\u0646\u062c\u0646 \u062a\u0631\u062c\u0645\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u06d2"
            ],
            "No engine is set up yet. Save a key above (or set up an AI model) to start translating.": [
                "\u0627\u0628\u06be\u06cc \u062a\u06a9 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062c\u0646 \u0633\u06cc\u0679 \u0627\u067e \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4 \u062a\u0631\u062c\u0645\u06c1 \u0634\u0631\u0648\u0639 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0648\u067e\u0631 \u0627\u06cc\u06a9 \u06a9\u0644\u06cc\u062f \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba (\u06cc\u0627 \u06a9\u0648\u0626\u06cc AI \u0645\u0627\u0688\u0644 \u0633\u06cc\u0679 \u0627\u067e \u06a9\u0631\u06cc\u06ba)\u06d4"
            ],
            "Default engine": [
                "\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u0637\u06d2 \u0634\u062f\u06c1 \u0627\u0646\u062c\u0646"
            ],
            "A different engine per language, automatic fallback and monthly spending caps are Tranzly Pro features.": [
                "\u06c1\u0631 \u0632\u0628\u0627\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0645\u062e\u062a\u0644\u0641 \u0627\u0646\u062c\u0646\u060c \u062e\u0648\u062f\u06a9\u0627\u0631 \u0641\u0627\u0644 \u0628\u06cc\u06a9 \u0627\u0648\u0631 \u0645\u0627\u06c1\u0627\u0646\u06c1 \u0627\u062e\u0631\u0627\u062c\u0627\u062a \u06a9\u06cc \u062d\u062f\u06cc\u06ba Tranzly Pro \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06c1\u06cc\u06ba\u06d4"
            ],
            "Engine for %s": [
                "%s \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u062c\u0646"
            ],
            "The default engine": [
                "\u067e\u06c1\u0644\u0627 \u0627\u0646\u062c\u0646"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062c\u0646 \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06cc\u0627 \u0627\u067e\u0646\u06cc \u062d\u062f \u062a\u06a9 \u067e\u06c1\u0646\u0686 \u062c\u0627\u0626\u06d2\u060c \u062a\u0648 \u0627\u0633 \u062a\u0631\u062a\u06cc\u0628 \u0633\u06d2 \u0627\u06af\u0644\u06cc \u0686\u06cc\u0632\u06cc\u06ba \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba\u06d4"
            ],
            "Monthly spending caps": [
                "\u0645\u0627\u06c1\u0627\u0646\u06c1 \u0627\u062e\u0631\u0627\u062c\u0627\u062a \u06a9\u06cc \u062d\u062f\u06cc\u06ba"
            ],
            "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap.": [
