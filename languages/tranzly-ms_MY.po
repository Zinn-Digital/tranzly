msgstr "Import"

#: src/admin/WorkflowTab.js:665
msgid "Undo the import"
msgstr "Buat asal import"

#: src/admin/WorkflowTab.js:701
msgid "Comments and product reviews"
msgstr "Komen dan ulasan produk"

#: src/admin/WorkflowTab.js:706
msgid "Each language keeps its own"
msgstr "Setiap bahasa mengekalkan bahasanya sendiri"

