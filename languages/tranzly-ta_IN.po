#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "மொழி மாற்றி"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "தளத்தின் ஒவ்வொரு மொழியிலும் இந்தப் பக்கத்திற்கான இணைப்புகள். இரண்டு அல்லது அதற்கு மேற்பட்ட மொழிகள் பட்டியலிடப்படும் வரை இது எதையும் வழங்காது."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "மொழி"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "மாற்றி"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "மொழிபெயர்ப்பு"
