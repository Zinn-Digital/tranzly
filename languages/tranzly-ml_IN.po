msgstr "%1$s v%2$s-യിലേക്ക് അപ്‌ഡേറ്റ് ചെയ്തതിന് നന്ദി!"

#: includes/class-rest.php:195
msgid "That language is not one of this site's languages."
msgstr "ആ ഭാഷ ഈ സൈറ്റിന്റെ ഭാഷകളിൽ ഒന്നല്ല."

#: includes/class-settings.php:74
msgid "The prefix must be 1 to 8 lowercase letters or digits, start with a letter, and must not name the plugin."
msgstr "പ്രീഫിക്സ് 1 മുതൽ 8 വരെ ചെറിയ അക്ഷരങ്ങളോ അക്കങ്ങളോ ആയിരിക്കണം, ഒരു അക്ഷരത്തിൽ ആരംഭിക്കണം, കൂടാതെ പ്ലഗിൻ്റെ പേര് ആകാനും പാടില്ല."

#. translators: %s: the language code that was refused.
#: includes/class-settings.php:89
#, php-format
msgid "\"%s\" is not a language code. Use a WordPress locale such as fr_FR or de_DE."
msgstr "\"%s\" ഒരു ഭാഷാ കോഡല്ല. fr_FR അല്ലെങ്കിൽ de_DE പോലുള്ള ഒരു WordPress ലൊക്കേൽ ഉപയോഗിക്കുക."

#: includes/class-settings.php:98
msgid "List at least one language."
msgstr "കുറഞ്ഞത് ഒരു ഭാഷയെങ്കിലും ലിസ്റ്റ് ചെയ്യുക."

#: includes/class-settings.php:105
msgid "That is more languages than one site can list."
msgstr "ഒരു സൈറ്റിന് ലിസ്റ്റ് ചെയ്യാൻ കഴിയുന്നതിനേക്കാൾ കൂടുതൽ ഭാഷകളാണത്."

