            ],
            "Upgrade": [
                "\u0644\u0648\u0693\u0648\u0644"
            ],
            "Built by Neil Lock, CEO of Zinn Digital\u00ae Ltd": [
                "\u062f Zinn Digital\u00ae Ltd \u0627\u062c\u0631\u0627\u06cc\u06cc\u0648\u064a \u0631\u06cc\u06cc\u0633 Neil Lock \u0644\u062e\u0648\u0627 \u062c\u0648\u0693 \u0634\u0648\u06cc"
            ],
