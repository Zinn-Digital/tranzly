            ],
            "Key saved. It is stored encrypted and never shown again.": [
                "\u0915\u093f\u0932\u094d\u0932\u0940 \u091c\u0924\u0928 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947. \u0924\u0940 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u0930\u0942\u0928 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947 \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u0915\u0927\u0940\u0939\u0940 \u0926\u0930\u094d\u0936\u0935\u0932\u0940 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940."
            ],
            "Engine settings saved.": [
                "\u0907\u0902\u091c\u093f\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u091c\u0924\u0928 \u0915\u0947\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924."
