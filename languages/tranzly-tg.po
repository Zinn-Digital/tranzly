msgstr "Масалан fr_FR"

#: src/admin/App.js:170
msgid "Name (optional)"
msgstr "Ном (ихтиёрӣ)"

#: src/admin/App.js:171
msgid "For example Français"
msgstr "Масалан, Français"

#: src/admin/App.js:185
msgid "Add language"
msgstr "Илова кардани забон"

#: src/admin/App.js:193
msgid "Front-end output"
msgstr "Натиҷаи пешина"

#: src/admin/App.js:198
msgid "Class name prefix"
msgstr "Пешванди номи синф"

#: src/admin/App.js:199
msgid "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter."
msgstr "Ҳар як номи синфе, ки плагин дар саҳифаҳои шумо чоп мекунад, бо ин пешванд оғоз меёбад, то саҳифаҳо ошкор накунанд, ки кадом плагин онҳоро сохтааст. Аз 1 то 8 ҳарфи хурди лотинӣ ё рақам, ки бо ҳарф оғоз меёбад."

#: src/admin/App.js:210
msgid "Beta updates"
msgstr "Навсозиҳои озмоишӣ"

#: src/admin/App.js:217
msgid "This site receives beta versions as updates."
msgstr "Ин сайт версияҳои бетаро ҳамчун навсозиҳо қабул мекунад."

#: src/admin/App.js:221
msgid "This site receives stable versions only."
msgstr "Ин сайт танҳо версияҳои устуворро қабул мекунад."

#: src/admin/App.js:230
msgid "Change this on the Account page"
msgstr "Инро дар саҳифаи Ҳисоб тағйир диҳед"

#: src/admin/App.js:239
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "Версияҳои бета ба насбҳои Pro-и лисензиядор, ки ба ҳисоби худ пайваст шудаанд, пешниҳод карда мешаванд. Пас аз пайваст шудан, шумо метавонед аз саҳифаи Ҳисоб ҳамроҳ шавед."

#: src/admin/App.js:255
msgid "Save settings"
msgstr "Танзимотро ҳифз кардан"

#: src/admin/Engines.js:87
msgid "First engine that is set up"
msgstr "Аввалин муҳаррики танзимшуда"

#: src/admin/Engines.js:110
msgid "Key saved. It is stored encrypted and never shown again."
msgstr "Kalit захира шуд. Он ба таври рамзгузоришуда нигоҳ дошта мешавад ва дигар ҳеҷ гоҳ нишон дода намешавад."

#: src/admin/Engines.js:120
msgid "Engine settings saved."
msgstr "Танзимоти муҳаррик захира карда шуданд."

#: src/admin/Engines.js:142
msgid "Glossary saved."
msgstr "Луғат захира шуд."

#: src/admin/Engines.js:163
msgid "Your keys"
msgstr "Калитҳои шумо"

#: src/admin/Engines.js:165
msgid "Tranzly calls the translation services with your own account. Keys are stored encrypted in your database and are only ever sent to the service they belong to. AI model keys are set in the AI settings."
msgstr "Tranzly хидматҳои тарҷумаро бо ҳисоби шахсии худ даъват мекунад. Калитҳо дар пойгоҳи додаи шумо бо рамзгузорӣ захира карда мешаванд ва танҳо ба ҳамон хидмате фиристода мешаванд, ки ба он тааллуқ доранд. Калитҳои модели AI дар танзимоти AI муқаррар карда мешаванд."

#. translators: %s: a translation service's name.
#: src/admin/Engines.js:183
#, js-format
msgid "%s API key"
msgstr "%s Калиди API"

#. translators: %s: the last characters of a saved key, masked.
#: src/admin/Engines.js:190
#, js-format
msgid "Saved: %s. Enter a new key to replace it, or save an empty field to remove it."
msgstr "Захира шуд: %s. Барои иваз кардани он калиди навро ворид кунед ё барои нест кардани он майдони холиро захира кунед."

#: src/admin/Engines.js:196
msgid "No key saved."
msgstr "Ягон калид захира нашудааст."

#: src/admin/Engines.js:209
msgid "Azure region (leave empty for a global resource)"
msgstr "Ноҳияи Azure (барои захираи глобалӣ холӣ гузоред)"

#: src/admin/Engines.js:223
msgid "Save key"
msgstr "Захира кардани калит"

#: src/admin/Engines.js:231
msgid "Check my DeepL usage"
msgstr "Санҷиши истифодаи DeepL-и ман"

#. translators: 1: characters used, 2: the account's limit.
#: src/admin/Engines.js:241
#, js-format
msgid "%1$s of %2$s characters used this billing period."
msgstr "Аз %2$s аломати муқарраршуда %1$s аломат дар ин давраи ҳисобдорӣ истифода шудааст."

#: src/admin/Engines.js:255
msgid "Which engine translates"
msgstr "Кадом муҳарrik тарҷума мекунад"

#: src/admin/Engines.js:260
msgid "No engine is set up yet. Save a key above (or set up an AI model) to start translating."
msgstr "Ҳанӯз ягон муҳарриқ танзим нашудааст. Барои оғози тарҷума калидеро дар боло захира кунед (ё модели сунъии зеҳниро танзим намоед)."

#: src/admin/Engines.js:268
msgid "Default engine"
msgstr "Муҳаррики пешфарз"

#: src/admin/Engines.js:277
msgid "A different engine per language, automatic fallback and monthly spending caps are Tranzly Pro features."
msgstr "Як муҳаррики гуногун барои ҳар як забон, муроҷиати худкор ва лимити хароҷоти моҳона аз хусусиятҳои Tranzly Pro мебошанд."

#. translators: %s: a language name.
#: src/admin/Engines.js:290
#, js-format
msgid "Engine for %s"
msgstr "Муҳаррик барои %s"

#: src/admin/Engines.js:299
msgid "The default engine"
msgstr "Мотори пешфарз"

#: src/admin/Engines.js:320
msgid "If an engine fails or reaches a limit, try these next, in this order"
msgstr "Агар муҳаррик аз кор монад ё ба маҳдудият расад, инҳоро бо ин тартиб санҷед"

#: src/admin/Engines.js:353
msgid "Monthly spending caps"
msgstr "Маҳдудиятҳои хароҷоти моҳона"

#: src/admin/Engines.js:357
msgid "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap."
msgstr "Вақте ки муҳаррик ба ҳадди ниҳоии худ мерасад, то моҳи оянда ба он чизи дигар фиристода намешавад ва ҳисоботи тарҷумаи ноком сабабро мегӯяд. Барои бе ҳадди ниҳоӣ мондан холӣ гузоред."

#. translators: 1: an engine's name, 2: dollars spent this month.
#: src/admin/Engines.js:371
#, js-format
msgid "%1$s (spent this month: $%2$s)"
msgstr "%1$s (моҳи ҷорӣ сарф шуд: $%2$s)"

#: src/admin/Engines.js:400
msgid "Save caps"
msgstr "Захираи ҳарфҳои калон"

#: src/admin/Engines.js:407
msgid "Glossary and words never translated"
msgstr "Луғат ва калимаҳое, ки ҳеҷ гоҳ тарҷума намешаванд"

#: src/admin/Engines.js:415
msgid "Never translate these words (one per line)"
msgstr "Ҳеҷ гоҳ ин калимаҳоро тарҷума накунед (як калима дар як сатр)"

