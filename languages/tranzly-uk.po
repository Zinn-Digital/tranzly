msgstr "Замінити зображення %s"

#. translators: %s: a language's name.
#: src/pro__premium_only/editor/index.js:87
#, js-format
msgid "Choose a %s image"
msgstr "Виберіть зображення для %s"

#: src/pro__premium_only/editor/index.js:108
