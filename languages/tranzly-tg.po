#: src/admin-kit/Support.js:584
msgid "Password"
msgstr "Парол"

#: src/admin-kit/Support.js:619
msgid "Add a login"
msgstr "Илова кардани воридшавӣ"

#: src/admin-kit/Support.js:626
msgid "Create a temporary support login"
msgstr "Эҷоди вуруди муваққатии пуштибонӣ"

#: src/admin-kit/Support.js:630
msgid "A separate user for our support team, without access to users, plugins installation or code editing. It is deleted automatically when it expires, or whenever you revoke it below."
msgstr "Як корбари алоҳида барои гурӯҳи дастгирии мо, бидуни дастрасӣ ба корбарон, насби плагинҳо ё таҳрири код. Он ҳангоми ба охир расидани муҳлати амал ё ҳангоми дар поён бекор кардани он ба таври худкор нест карда мешавад."

#. translators: %d: number of days.
#: src/admin-kit/Support.js:645
#, js-format
msgid "Yes, for %d day"
msgid_plural "Yes, for %d days"
msgstr[0] "Бале, барои %d рӯз"

#: src/admin-kit/Support.js:669
msgid "Send"
msgstr "Ирсол"

#: src/admin-kit/Support.js:694
msgid "The list could not be loaded."
msgstr "Рӯйхатро бор кардан ғайриимкон аст."

#: src/admin-kit/Support.js:709
msgid "That login could not be removed."
msgstr "Он номи корбарӣ нест карда нашуд."

#: src/admin-kit/Support.js:721
msgid "Temporary support logins"
msgstr "Логовҳои муваққатии дастгирӣ"

#: src/admin-kit/Support.js:733
msgid "None. Support can only log in to this site if you create a login here."
msgstr "Ҳеҷ кас. Дастгирӣ танҳо дар сурати дар ин ҷо сохтани номи корбарӣ метавонад ба ин сайт ворид шавад."

#: src/admin-kit/Support.js:745
msgid "expired, being removed"
msgstr "мӯҳлаташ гузаштааст, нест карда истодааст"

#. translators: %s: date and time.
#: src/admin-kit/Support.js:751
#, js-format
msgid "expires %s"
msgstr "муҳлати %s тамом мешавад"

#: src/admin-kit/Support.js:764
msgid "Revoke now"
msgstr "Бекор кардан ҳоло"

#. translators: 1: this step, 2: number of steps.
#: src/admin-kit/Tour.js:98
#, js-format
msgid "Step %1$d of %2$d"
msgstr "Қадами %1$d аз %2$d"

#: src/admin-kit/Tour.js:109
msgid "Close the tour"
msgstr "Пӯшидани саёҳат"

#: src/admin-kit/Tour.js:116
#: src/admin-kit/Wizard.js:114
msgid "Back"
msgstr "Бозгашт"

#: src/admin-kit/tours.js:13
msgid "Everything in one place"
msgstr "Ҳама чиз дар як ҷой"

#: src/admin-kit/tours.js:14
msgid "These tabs lead to every screen of the plugin: setup, settings, your licence, help and more."
msgstr "Ин ҷадвалҳо шуморо ба ҳар як экрани плагин равона мекунанд: насб, танзимот, литсензияи шумо, кӯмак ва ғайра."

#: src/admin-kit/tours.js:21
msgid "Help on every screen"
msgstr "Кӯмак дар ҳар як экран"

#: src/admin-kit/tours.js:22
msgid "Open this menu for the guide to the screen you are on, this tour, or to ask us for help."
msgstr "Барои дастур оид ба экрани кушодаи худ, ин сафар ё дархости кӯмак аз мо ин менюро кушоед."

#: src/admin-kit/tours.js:29
msgid "Light or dark"
msgstr "Рӯшан ё торик"

#: src/admin-kit/tours.js:30
msgid "Choose light, dark, or the same as your computer. Your choice is remembered for you only."
msgstr "Равшан, торик ё мувофиқи компютери худро интихоб кунед. Интихоби шумо танҳо барои шумо дар хотир нигоҳ дошта мешавад."

#: src/admin-kit/tours.js:39
#: src/admin-kit/Wizard.js:41
msgid "Welcome"
msgstr "Хуш омадед"

#: src/admin-kit/tours.js:40
msgid "This short tour shows where things are. You can leave it at any time with Escape."
msgstr "Ин сайри кӯтоҳ нишон медиҳад, ки чизҳо дар куҷо ҷойгиранд. Шумо метавонед онро дар вақти дилхоҳ бо тугмаи Escape тарк кунед."

#: src/admin-kit/tours.js:48
msgid "Your site at a glance"
msgstr "Сайти шумо дар як нигоҳ"

#: src/admin-kit/tours.js:49
msgid "Setup progress and your plan are shown here, with the next thing worth doing."
msgstr "Пешрафти танзимот ва нақшаи шумо дар ин ҷо бо кори навбатии арзишманд нишон дода шудаанд."

#: src/admin-kit/tours.js:61
msgid "Your plan, how many sites it covers, and whether this copy of the site counts toward that limit."
msgstr "Нақшаи шумо, шумораи сомонаҳое, ки он фаро мегирад ва оё ин нусхаи сомона ба он маҳдудият дохил мешавад ё на."

#: src/admin-kit/tours.js:68
msgid "Try Pro or upgrade"
msgstr "Pro-ро санҷед ё навсозӣ кунед"

#: src/admin-kit/tours.js:69
msgid "Start a free trial without a card, upgrade, or renew, all from here."
msgstr "Оғози санҷиши ройгон бидуни корти бонкӣ, навсозӣ ё тамдид — ҳамааш аз ҳамин ҷо."

#: src/admin-kit/tours.js:77
msgid "Every feature and the plan that includes it. Search for a feature or show one area at a time."
msgstr "Ҳар як хусусият ва нақшае, ки онро дар бар мегирад. Хусусиятро ҷустуҷӯ кунед ё як минтақаро дар як вақт нишон диҳед."

#: src/admin-kit/tours.js:86
msgid "More from Zinn Digital®"
msgstr "Бештар аз Zinn Digital®"

#: src/admin-kit/tours.js:87
msgid "Plugins that work with this one, and services from the same team. Cards you hid on other screens can be shown again here."
msgstr "Плагинҳое, ки бо ин кор мекунанд, ва хидматҳо аз ҳамон гурӯҳ. Кортҳое, ки дар экранҳои дигар пинҳон карда будед, метавонанд дар ин ҷо аз нав нишон дода шаванд."

#: src/admin-kit/tours.js:96
msgid "Connect for faster help"
msgstr "Барои кӯмаки зуд пайваст шавед"

#: src/admin-kit/tours.js:97
msgid "Connecting is optional. It lets you send requests without typing your e-mail each time, and you can disconnect whenever you like."
msgstr "Пайвастшавӣ ихтиёрӣ аст. Он ба шумо имкон медиҳад, ки дархостҳоро бидуни ворид кардани почтаи электронии худ дар ҳар дафъа фиристед ва шумо метавонед ҳар вақте ки хоҳед, ҷудо шавед."

#: src/admin-kit/tours.js:104
msgid "Ask for help or report a bug"
msgstr "Кӯмак пурсед ё хатогиро гузориш диҳед"

#: src/admin-kit/tours.js:105
msgid "Describe what happened. You choose whether to attach site information, and you can see exactly what it contains first."
msgstr "Тавсиф кунед, ки чӣ рӯй дод. Шумо интихоб мекунед, ки оё маълумоти сайт замима карда шавад ва пеш аз ҳама метавонед бубинед, ки он бевосита чӣ дорад."

#: src/admin-kit/tours.js:112
msgid "Temporary support access"
msgstr "Дастрасии муваққатии пуштибонӣ"

#: src/admin-kit/tours.js:113
msgid "If support needs to look inside your site, create a temporary login here. It deletes itself when it expires, and you can remove it at any time."
msgstr "Агар дастгирӣ лозим бошад, ки ба даруни сайти шумо назар кунад, дар ин ҷо воридшавии муваққатӣ эҷод кунед. Он ҳангоми мӯҳлати тамом шуданаш худаш нест мешавад ва шумо метавонед онро дар вақти дилхоҳ нест кунед."

#: src/admin-kit/tours.js:122
msgid "Tell us what to build"
msgstr "Ба мо бигӯед, ки чӣ созем"

#: src/admin-kit/tours.js:123
msgid "Send an idea, a feature request or any feedback. It goes straight to the team."
msgstr "Як идея, дархости функсия ё ягон фикру мулоҳиза фиристед. Он мустақиман ба даста мерасад."

#. translators: %s: plugin name.
#: src/admin-kit/Wizard.js:46
#, js-format
msgid "This takes a few minutes and sets up %s so it works on this site straight away. You can change everything later."
msgstr "Ин чанд дақиқа вақт мегирад ва %s-ро тавре танзим мекунад, ки он фавран дар ин сайт кор кунад. Шумо метавонед ҳама чизро баъдтар тағйир диҳед."

#: src/admin-kit/Wizard.js:62
msgid "You are ready. If anything does not work as expected, we are one click away."
msgstr "Шумо омодаед. Агар ягон чиз мувофиқи интизорӣ кор накунад, мо бо як пахшкунӣ дар назди шумо ҳастем."

#. translators: 1: step number, 2: number of steps, 3: step title.
#: src/admin-kit/Wizard.js:89
#, js-format
msgid "Step %1$d of %2$d: %3$s"
msgstr "Қадами %1$d аз %2$d: %3$s"

#: src/admin-kit/Wizard.js:119
msgid "Finish"
msgstr "Анҷом додан"

#: src/admin-kit/Wizard.js:131
msgid "Skip setup"
msgstr "Гузаштан аз танзимот"

