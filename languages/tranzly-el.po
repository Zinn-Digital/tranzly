msgstr "Το κείμενο μεταφράστηκε. Πατήστε Enter για να το διορθώσετε."

#: src/pro__premium_only/visual/index.js:105
msgid "Click any outlined text to correct its translation."
msgstr "Κάντε κλικ σε οποιοδήποτε κείμενο με περίγραμμα για να διορθώσετε τη μετάφρασή του."

#: src/pro__premium_only/visual/index.js:109
msgid "No translated text was found on this page to edit here. Use the side-by-side editor instead."
msgstr "Δεν βρέθηκε μεταφρασμένο κείμενο σε αυτή τη σελίδα για επεξεργασία εδώ. Χρησιμοποιήστε αντί αυτού τον διπλανό επεξεργαστή."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Εναλλαγή γλώσσας"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Σύνδεσμοι προς αυτή τη σελίδα σε κάθε μία από τις γλώσσες του ιστότοπου. Δεν εμφανίζει τίποτα μέχρι να καταχωριστούν δύο ή περισσότερες γλώσσες."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Γλώσσα"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "εναλλαγή"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "μετάφραση"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Δίνει τη δυνατότητα στους επισκέπτες να διαβάζουν αυτή τη σελίδα σε μια άλλη από τις γλώσσες σας: λίστα, χάπια, κουμπιά, αναπτυσσόμενο μενού ή κωδικοί γλώσσας, με προαιρετικές σημαίες."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "πολυγλωσσικό"
