msgstr "Ang site na ito ay tumatanggap lamang ng mga matatag na bersyon."

#: src/admin/App.js:230
msgid "Change this on the Account page"
msgstr "Palitan ito sa pahina ng Account"

#: src/admin/App.js:239
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "Inaalok ang mga bersyong beta sa mga lisensyadong pag-install ng Pro na nakakonekta sa kanilang account. Kapag nakakonekta na, maaari kang sumali mula sa pahina ng Account."

#: src/admin/App.js:255
msgid "Save settings"
msgstr "I-save ang mga setting"

#: src/admin/Engines.js:82
msgid "First engine that is set up"
msgstr "Unang makina na naka-set up"

#: src/admin/Engines.js:105
msgid "Key saved. It is stored encrypted and never shown again."
msgstr "Nai-save na ang key. Naka-encrypt ito kapag nakaimbak at hindi na kailanman ipapakita muli."

#: src/admin/Engines.js:115
msgid "Engine settings saved."
msgstr "Na-save na ang mga setting ng makina."

#: src/admin/Engines.js:137
msgid "Glossary saved."
msgstr "Na-save ang Glossary."

#: src/admin/Engines.js:158
msgid "Your keys"
msgstr "Ang iyong mga susi"

#: src/admin/Engines.js:160
msgid "Tranzly calls the translation services with your own account. Keys are stored encrypted in your database and are only ever sent to the service they belong to. AI model keys are set in the AI settings."
msgstr "Ang Tranzly ay tumatawag sa mga serbisyo ng pagsasalin gamit ang iyong sariling account. Ang mga susi ay nakaimbak nang naka-encrypt sa iyong database at ipinapadala lamang sa serbisyo kung saan sila nabibilang. Ang mga susi ng modelo ng AI ay itinakda sa mga setting ng AI."

#. translators: %s: a translation service's name.
#: src/admin/Engines.js:178
#, js-format
msgid "%s API key"
msgstr "%s API key"

#. translators: %s: the last characters of a saved key, masked.
#: src/admin/Engines.js:185
#, js-format
msgid "Saved: %s. Enter a new key to replace it, or save an empty field to remove it."
msgstr "Na-save na: %s. Maglagay ng bagong key para palitan ito, o i-save ang isang blangkong field para tanggalin ito."

#: src/admin/Engines.js:191
msgid "No key saved."
msgstr "Walang naka-save na key."

#: src/admin/Engines.js:204
msgid "Azure region (leave empty for a global resource)"
msgstr "Rehiyon ng Azure (iwanang blangko para sa isang global na mapagkukunan)"

#: src/admin/Engines.js:218
msgid "Save key"
msgstr "I-save ang key"

#: src/admin/Engines.js:226
msgid "Check my DeepL usage"
msgstr "Suriin ang aking paggamit ng DeepL"

#. translators: 1: characters used, 2: the account's limit.
#: src/admin/Engines.js:236
#, js-format
msgid "%1$s of %2$s characters used this billing period."
msgstr "%1$s sa %2$s na character ang nagamit sa billing period na ito."

#: src/admin/Engines.js:250
msgid "Which engine translates"
msgstr "Aling makina ang nagsasalin"

#: src/admin/Engines.js:255
msgid "No engine is set up yet. Save a key above (or set up an AI model) to start translating."
msgstr "Wala pang nakatakdang engine. Mag-save ng key sa itaas (o mag-set up ng AI model) para simulan ang pagsasalin."

#: src/admin/Engines.js:263
msgid "Default engine"
msgstr "Default na engine"

#: src/admin/Engines.js:272
msgid "A different engine per language, automatic fallback and monthly spending caps are Tranzly Pro features."
msgstr "Ang magkaibang engine bawat wika, awtomatikong fallback, and buwanang limitasyon sa paggastos ay mga tampok ng Tranzly Pro."

#. translators: %s: a language name.
#: src/admin/Engines.js:285
#, js-format
msgid "Engine for %s"
msgstr "Engine para sa %s"

#: src/admin/Engines.js:294
msgid "The default engine"
msgstr "Ang default na engine"

#: src/admin/Engines.js:315
msgid "If an engine fails or reaches a limit, try these next, in this order"
msgstr "Kung ang isang engine ay mabigo o umabot sa limitasyon, subukan ang mga sumusunod, sa ganitong pagkakasunud-sunod"

#: src/admin/Engines.js:348
msgid "Monthly spending caps"
msgstr "Buwanang gastusin sa caps"

#: src/admin/Engines.js:352
msgid "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap."
msgstr "Kapag umabot sa limitasyon nito ang isang makina, wala nang ipinapadala rito hanggang sa susunod na buwan at ipinapakita ng ulat ng nabigong pagsasalin ang dahilan. Iwanang bakante kung walang limitasyon."

#. translators: 1: an engine's name, 2: dollars spent this month.
#: src/admin/Engines.js:366
#, js-format
msgid "%1$s (spent this month: $%2$s)"
msgstr "%1$s (nagastos ngayong buwan: $%2$s)"

#: src/admin/Engines.js:395
msgid "Save caps"
msgstr "I-save ang mga takip"

#: src/admin/Engines.js:402
msgid "Glossary and words never translated"
msgstr "Glosaryo at mga salitang hindi kailanman isinalin"

#: src/admin/Engines.js:410
msgid "Never translate these words (one per line)"
msgstr "Huwag kailanman isalin ang mga salitang ito (isa sa bawat linya)"

#: src/admin/Engines.js:414
msgid "Brand and product names stay exactly as they are, with every engine."
msgstr "Ang mga pangalan ng brand at produkto ay nananatiling eksakto kung ano sila, sa bawat engine."

#: src/admin/Engines.js:425
msgid "Preferred translations and tone per language are Tranzly Pro features."
msgstr "Ang mga gustong salin at tono para sa bawat wika ay mga feature ng Tranzly Pro."

#: src/admin/Engines.js:440
msgid "Preferred translations (one per line: term = translation)"
msgstr "Mga ginustong pagsasalin (isa bawat linya: term = translation)"

#: src/admin/Engines.js:460
msgid "Formality"
msgstr "Pormalidad"

#: src/admin/Engines.js:468
msgid "Default"
msgstr "Default"

#: src/admin/Engines.js:475
msgid "Formal"
msgstr "Pormal"

#: src/admin/Engines.js:482
msgid "Informal"
msgstr "Hindi pormal"

#: src/admin/Engines.js:505
msgid "Style instructions (audience, brand voice)"
msgstr "Mga tagubilin sa estilo (mga tagapakinig, boses ng brand)"

#: src/admin/Engines.js:537
msgid "Save glossary"
msgstr "I-save ang glosaryo"

