msgstr "പശ്ചാത്തലത്തിൽ വിവർത്തനം ചെയ്യുക"

#: src/admin/Jobs.js:210
msgid "Set up a translation engine in the Engines tab first."
msgstr "ആദ്യം എഞ്ചിൻസ് ടാബിൽ ഒരു വിവർത്തന എഞ്ചിൻ സജ്ജീകരിക്കുക."

#: src/admin/Jobs.js:219
msgid "Translate every"
msgstr "എല്ലാം വിവർത്തനം ചെയ്യുക"

#: src/admin/Jobs.js:230
msgid "Into"
msgstr "ഉള്ളിലേക്ക്"

#: src/admin/Jobs.js:258
msgid "With"
msgstr "ഉപയോഗിച്ച്"

#: src/admin/Jobs.js:263
msgid "Each language’s own engine"
msgstr "ഓരോ ഭാഷയുടെയും സ്വന്തം എഞ്ചിൻ"

#: src/admin/Jobs.js:279
msgid "Publish the translations (otherwise they are saved as drafts)"
msgstr "വിവർത്തനങ്ങൾ പ്രസിദ്ധീകരിക്കുക (അല്ലെങ്കിൽ അവ ഡ്രാഫ്റ്റുകളായി സംരക്ഷിക്കപ്പെടും)"

#: src/admin/Jobs.js:293
msgid "Estimate the cost"
msgstr "ചെലവ് കണക്കാക്കുക"

#. translators: 1: number of posts, 2: characters.
#: src/admin/Jobs.js:300
#, js-format
msgid "%1$d posts, %2$s characters. The price for this engine is not known in advance."
msgstr "%1$d പോസ്റ്റുകൾ, %2$s അക്ഷരങ്ങൾ. ഈ എൻജിന്റെ വില മുൻകൂട്ടി അറിയാൻ കഴിയില്ല."

#. translators: 1: number of posts, 2: characters, 3: an amount in US dollars.
#: src/admin/Jobs.js:309
#, js-format
msgid "%1$d posts, %2$s characters: about $%3$s on your own account."
msgstr "%1$d പോസ്റ്റുകൾ, %2$s പ്രതീകങ്ങൾ: നിങ്ങളുടെ സ്വന്തം അക്കൗണ്ടിൽ ഏകദേശം $%3$s."

#: src/admin/Jobs.js:327
msgid "Start translating"
msgstr "വിവർത്തനം ചെയ്തുതുടങ്ങുക"

#: src/admin/Jobs.js:333
msgid "Jobs"
msgstr "ജോലികൾ"

#: src/admin/Jobs.js:335
msgid "No translation jobs yet."
msgstr "യൂഷ്കാല പരിഭാഷകളൊന്നും ലഭ്യമല്ല."

#. translators: 1: job number, 2: job status.
#: src/admin/Jobs.js:343
#, js-format
msgid "Job %1$d — %2$s"
msgstr "ജോബ് %1$d — %2$s"

#. translators: 1: translated, 2: total, 3: failed, 4: skipped.
#: src/admin/Jobs.js:350
#, js-format
msgid "%1$d of %2$d translated, %3$d failed, %4$d skipped (protected or already in that language)"
msgstr "%1$d / %2$d വിവർത്തനം ചെയ്തു, %3$d പരാജയപ്പെട്ടു, %4$d ഒഴിവാക്കി (സംരക്ഷിക്കപ്പെട്ടവ അല്ലെങ്കിൽ ആ ഭാഷയിൽ ഇതിനകം ഉള്ളവ)"

#: src/admin/Jobs.js:367
msgid "Stop this job"
msgstr "ഈ ജോലി നിർത്തുക"

