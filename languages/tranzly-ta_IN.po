msgstr "அந்தத் தேர்வில் நீங்கள் மொழிபெயர்க்க அனுமதிக்கப்பட்ட எதுவும் இல்லை."

#: includes/core/class-queue.php:364
#: includes/core/class-queue.php:411
msgid "That item is not part of a translation job."
msgstr "அந்த உருப்படி மொழிபெயர்ப்புப் பணியின் ஒரு பகுதி அல்ல."

#: includes/core/class-queue.php:422
#: includes/core/class-translator.php:100
#: includes/core/class-translator.php:165
msgid "You are not allowed to change that translation."
msgstr "அந்த மொழிபெயர்ப்பை மாற்ற உங்களுக்கு அனுமதி இல்லை."

#. translators: 1: language code, 2: the ID of the item that already has it.
#: includes/core/class-relations.php:210
#: includes/core/class-relations.php:264
#, php-format
msgid "This item's group already has a %1$s version (#%2$d)."
msgstr "இந்த உருப்படியின் குழுவில் ஏற்கனவே ஒரு %1$s பதிப்பு (#%2$d) உள்ளது."

#: includes/core/class-relations.php:242
msgid "An item cannot be its own translation."
msgstr "ஒரு பொருள் அதன் சொந்த மொழிபெயர்ப்பாக இருக்க முடியாது."

#: includes/core/class-relations.php:273
msgid "That item is already a translation of something else. Unlink it first."
msgstr "அந்தப் பொருள் ஏற்கனவே வேறு ஒன்றின் மொழிபெயர்ப்பாக உள்ளது. முதலில் அதை இணைப்பிலிருந்து விலக்கவும்."

#: includes/core/class-relations.php:405
msgid "The translation link could not be saved."
msgstr "மொழிபெயர்ப்பு இணைப்பை சேமிக்க முடியவில்லை."

#: includes/core/class-strings.php:102
#: includes/core/class-strings.php:144
msgid "That text cannot be translated here."
msgstr "அந்த உரையை இங்கு மொழிபெயர்க்க முடியாது."

#: includes/core/class-strings.php:169
msgid "That media text cannot be translated here."
msgstr "அந்த ஊடக உரையை இங்கே மொழிபெயர்க்க முடியாது."

#: includes/core/class-translator.php:86
msgid "A translation can be published or kept as a draft."
msgstr "ஒரு மொழிபெயர்ப்பை வெளியிடலாம் அல்லது வரைவாக வைத்திருக்கலாம்."

#: includes/core/class-translator.php:90
msgid "You are not allowed to publish this kind of content."
msgstr "இந்த வகையான உள்ளடக்கத்தை வெளியிட உங்களுக்கு அனுமதி இல்லை."

#: includes/core/class-translator.php:94
msgid "This item is already written in that language."
msgstr "இந்த உருப்படி ஏற்கனவே அந்த மொழியில் எழுதப்பட்டுள்ளது."

#: includes/core/class-translator.php:108
#: includes/core/class-translator.php:252
msgid "This translation was edited by a person (or imported), so it is protected. Unlock it to translate it again."
msgstr "இந்த மொழிபெயர்ப்பு ஒருவரால் திருத்தப்பட்டது (அல்லது இறக்குமதி செய்யப்பட்டது), எனவே இது பாதுகாக்கப்பட்டுள்ளது. அதை மீண்டும் மொழிபெயர்க்க பூட்டைத் திறக்கவும்."

#: includes/core/class-translator.php:160
msgid "That item does not exist."
msgstr "அந்தப் பொருள் இல்லை."

#: includes/core/class-translator.php:405
msgid "No translation engine is set up yet. Add a key for one in Tranzly → Engines."
msgstr "மொழிபெயர்ப்புப் பொறி எதுவும் இன்னும் அமைக்கப்படவில்லை. Tranzly → Engines பகுதியில் அதற்கான விசையைச் சேர்க்கவும்."

#: includes/core/class-translator.php:408
msgid "That translation engine is not set up yet: add its key first."
msgstr "அந்த மொழிபெயர்ப்பு இயந்திரம் இன்னும் அமைக்கப்படவில்லை: முதலில் அதன் விசையைச் சேர்க்கவும்."

#: includes/core/class-translator.php:497
msgid "The same text is being translated by another job right now; this item will use that answer."
msgstr "அதே உரை தற்போது மற்றொரு பணியால் மொழிபெயர்க்கப்பட்டு வருகிறது; இந்த உருப்படி அந்த பதிலைப் பயன்படுத்தும்."

#: includes/core/class-translator.php:545
msgid "No translation engine could take this item."
msgstr "எந்த மொழிபெயர்ப்பு இயந்திரமும் இந்த உருப்படியை எடுக்க முடியவில்லை."

#: includes/core/class-translator.php:566
msgid "The engine did not return a translation for every part of this item. Nothing was changed."
msgstr "இந்த உருப்படியின் ஒவ்வொரு பகுதிக்கும் இயந்திரம் மொழிபெயர்ப்பைத் தரவில்லை. எதுவும் மாற்றப்படவில்லை."

#: includes/engines/class-ai.php:65
msgid "AI model"
msgstr "AI மாதிரி"

