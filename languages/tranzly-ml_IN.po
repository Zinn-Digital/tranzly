#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "ലാംഗ്വേജ് സ്വിച്ചർ"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "സൈറ്റിന്റെ ഓരോ ഭാഷയിലുമുള്ള ഈ പേജിലേക്കുള്ള ലിങ്കുകൾ. രണ്ടോ അതിലധികമോ ഭാഷകൾ പട്ടികപ്പെടുത്തുന്നത് വരെ ഇത് ഒന്നും കാണിക്കില്ല."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ഭാഷ"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "സ്വിച്ചർ"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "വിവർത്തനം ചെയ്യുക"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "സന്ദർശകരെ നിങ്ങളുടെ മറ്റ് ഭാഷകളിൽ ഈ പേര് വായിക്കാൻ അനുവദിക്കുക: ലിസ്റ്റ്, പില്ലുകൾ, ബട്ടണുകൾ, ഡ്രോപ്പ്ഡൗൺ അല്ലെങ്കിൽ ഫ്ലാഗുകൾക്കൊപ്പം (ഐച്ഛികം) ഭാഷാ കോഡുകൾ."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "ബഹുഭാഷാ"
