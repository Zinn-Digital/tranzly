#: includes/engines/class-failure.php:100
#, php-format
msgid "%s did not accept your API key. Check the key in Tranzly → Engines."
msgstr "%s نے آپ کی API کلید قبول نہیں کی۔ Tranzly → Engines میں کلید چیک کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:103
#, php-format
msgid "Your %s account has used up its quota or balance. Top it up with them, or use another engine."
msgstr "آپ کے %s اکاؤنٹ کا کوٹہ یا بیلنس ختم ہو چکا ہے۔ اس میں مزید رقم شامل کریں یا کوئی دوسرا انجن استعمال کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:106
#, php-format
msgid "%s asked us to slow down. It will be tried again automatically."
msgstr "%s نے ہمیں رفتار کم کرنے کا کہا ہے۔ اس کی کوشش خود بخود دوبارہ کی جائے گی۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:109
#, php-format
msgid "This text is too long for %s in one go. Split the content, or use another engine."
msgstr "یہ متن ایک بار میں %s کے لیے بہت طویل ہے۔ مواد کو تقسیم کریں، یا کوئی دوسرا انجن استعمال کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:112
#, php-format
msgid "%s refused to translate this content. Try another engine, or translate it by hand."
msgstr "%s نے اس مواد کا ترجمہ کرنے سے انکار کر دیا۔ کوئی دوسرا انجن آزمائیں، یا خود ترجمہ کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:115
#, php-format
msgid "%s does not translate this language. Choose another engine for it."
msgstr "%s اس زبان کا ترجمہ نہیں کرتا۔ اس کے لیے دوسرا انجن منتخب کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:118
#, php-format
msgid "This month's spending cap for %s is reached, so nothing more was sent to it. Raise the cap in Tranzly → Engines, or wait until next month."
msgstr "اس ماہ کے لیے %s کی اخراجات کی حد پوری ہو چکی ہے، اس لیے اس پر مزید کچھ نہیں بھیجا گیا۔ Tranzly → Engines میں حد بڑھائیں، یا اگلے ماہ تک انتظار کریں۔"

#. translators: %s: a translation service's name.
#: includes/engines/class-failure.php:121
#, php-format
msgid "The translation with %s failed for a reason Tranzly could not identify. The details are below."
msgstr "%s کے ساتھ ترجمہ ایک ایسی وجہ سے ناکام ہو گیا جسے Tranzly شناخت نہیں سکا۔ تفصیلات ذیل میں ہیں۔"

#: includes/engines/class-registry.php:76
msgid "An engine id must be lowercase letters, digits and hyphens."
msgstr "ایک انجن آئی ڈی صرف چھوٹے حروف، ہندسوں اور ہائفن پر مشتمل ہونی چاہیے۔"

