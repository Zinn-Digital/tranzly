#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Penukar bahasa"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Pautan ke halaman ini dalam setiap bahasa tapak. Ia tidak memaparkan apa-apa sehingga dua atau lebih bahasa disenaraikan."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "bahasa"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "penukar"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "terjemahan"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Membolehkan pelawat membaca halaman ini dalam bahasa lain anda: senarai, pil, butang, menu dropdown atau kod bahasa, dengan bendera pilihan."

#: blocks/language-switcher/block.json
