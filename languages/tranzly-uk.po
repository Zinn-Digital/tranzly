msgstr "Спочатку спрямуйте домен на цей сайт. Мова без домену використовує папку на вашому основному домені."

#: src/admin/Urls.js:176
msgid "Where each language lives now"
msgstr "Де кожна мова мешкає зараз"

#: src/admin/Urls.js:192
msgid "Translated address words"
msgstr "Перекладені слова адреси"

#: src/admin/Urls.js:196
msgid "Page and post addresses come from their translated titles. Here you translate the fixed words, so /de/kategorie/ replaces /de/category/."
msgstr "Адреси сторінок і публікацій створюються на основі їхніх перекладених заголовків. Тут ви перекладаєте фіксовані слова, тому /de/kategorie/ замінює /de/category/."

#. translators: 1: what the word is for (Category), 2: the word WordPress uses now.
#: src/admin/Urls.js:213
#, js-format
msgid "%1$s (now “%2$s”)"
msgstr "%1$s (тепер «%2$s»)"

#. zinn-i18n: human translation — the machine translator refused this string
#: src/admin/Urls.js:245
msgid "Search engines and visitors"
msgstr "Пошукові системи та відвідувачі"

#. zinn-i18n: human translation — the machine translator refused this string
#: src/admin/Urls.js:250
msgid "Offer visitors their own language with a small banner (never a redirect)"
msgstr "Пропонувати відвідувачам їхню мову за допомогою невеликого банера (ніколи не переспрямовувати)"

#: src/admin/Urls.js:259
msgid "Hide untranslated pages from search engines (noindex)"
msgstr "Приховати неперекладені сторінки від пошукових систем (noindex)"

#: src/admin/Urls.js:265
msgid "A translation that still holds the original text is kept out of search results until it is translated."
msgstr "Переклад, який все ще містить оригінальний текст, не показується в результатах пошуку, доки не буде перекладено."

#: src/admin/Urls.js:269
msgid "Part of Tranzly Pro."
msgstr "Частина Tranzly Pro."

#: src/admin/Urls.js:278
msgid "Tranzly adds hreflang links (with x-default), the page language and direction, and every language to your sitemap:"
msgstr "Tranzly додає посилання hreflang (з x-default), мову та напрямок сторінки, а також кожну мову до вашої карти сайту:"

#. translators: %s: names of SEO plugins, such as Yoast SEO.
#: src/admin/Urls.js:292
#, js-format
msgid "Working together with: %s."
msgstr "Працює у співпраці з: %s."

#: src/admin/Urls.js:309
msgid "Each address word is 2 to 12 lowercase letters, digits or hyphens."
msgstr "Кожне слово адреси складається з 2–12 малих літер, цифр або дефісів."

#: src/compare/index.js:66
msgid "Saved. The pieces you changed are marked as checked by a person, and this translation is protected from machine translation."
msgstr "Збережено. Змінені фрагменти позначено як перевірені людиною, і цей переклад захищено від машинного перекладу."

#: src/compare/index.js:92
msgid "The layout of this translation was changed in the editor, so some pieces no longer pair with the original. Pieces without a partner are shown empty; edit the rest in the editor."
msgstr "Макет цього перекладу було змінено в редакторі, тому деякі фрагменти більше не збігаються з оригіналом. Фрагменти без пари відображаються порожніми; відредагуйте решту в редакторі."

#: src/compare/index.js:96
msgid "Open the editor"
msgstr "Відкрити редактор"

#. translators: %s: a language tag such as en-US.
#: src/compare/index.js:105
#, js-format
msgid "Original (%s)"
msgstr "Оригінал (%s)"

#. translators: %s: a language tag such as de-DE.
#: src/compare/index.js:112
#, js-format
msgid "Translation (%s)"
msgstr "Переклад (%s)"

#: src/compare/index.js:162
msgid "Save changes"
msgstr "Зберегти зміни"

#: src/compare/index.js:164
msgid "Open in the editor"
msgstr "Відкрити в редакторі"

#: src/compare/model.js:37
#: src/editor/translations-model.js:38
msgid "Machine translated"
msgstr "Перекладено машинним способом"

#: src/compare/model.js:38
