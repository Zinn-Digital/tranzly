#, js-format
msgid "Version %s"
msgstr "ಆವೃತ್ತಿ %s"

#: src/admin/About.js:32
msgid "Tranzly website"
msgstr "Tranzly ವೆಬ್‌ಸೈಟ್"

#: src/admin/About.js:37
msgid "Zinn Digital® website"
msgstr "Zinn Digital® ವೆಬ್‌ಸೈಟ್"

#: src/admin/App.js:62
#: src/admin/Switchers.js:66
msgid "Settings saved."
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ."

#: src/admin/App.js:103
msgid "See the Pro plans and pricing"
msgstr "ಪ್ರೊ ಯೋಜನೆಗಳು ಮತ್ತು ಬೆಲೆಯನ್ನು ನೋಡಿ"

#: src/admin/App.js:113
#: src/admin/index.js:29
#: src/admin/StatusTab.js:551
#: src/editor/visibility.js:51
msgid "Languages"
msgstr "ಭಾಷೆಗಳು"

#: src/admin/App.js:117
msgid "The first language is the one your content is written in. Visitors switch with the language switcher block."
msgstr "ಮೊದಲ ಭಾಷೆಯು ನಿಮ್ಮ ವಿಷಯವನ್ನು ಬರೆಯಲಾದ ಭಾಷೆಯಾಗಿದೆ. ಸಂದರ್ಶಕರು ಭಾಷಾ ಬದಲಾಯಿಸುವ ಬ್ಲಾಕ್ ಮೂಲಕ ಬದಲಾಯಿಸುತ್ತಾರೆ."

#: src/admin/App.js:131
msgid "(default)"
msgstr "(ಡೀಫಾಲ್ಟ್)"

#: src/admin/App.js:158
msgid "Locale code"
msgstr "ಲೋಕಲ್ ಕೋಡ್"

#: src/admin/App.js:159
msgid "For example fr_FR"
msgstr "ಉದಾಹರಣೆಗೆ fr_FR"

#: src/admin/App.js:170
msgid "Name (optional)"
msgstr "ಹೆಸರು (ಐಚ್ಛಿಕ)"

#: src/admin/App.js:171
msgid "For example Français"
msgstr "ಉದಾಹರಣೆಗೆ Français"

#: src/admin/App.js:185
msgid "Add language"
msgstr "ಭಾಷೆಯನ್ನು ಸೇರಿಸಿ"

#: src/admin/App.js:193
msgid "Front-end output"
msgstr "ಫ್ರಂಟ್-ಎಂಡ್ ಔಟ್‌ಪುಟ್"

#: src/admin/App.js:198
msgid "Class name prefix"
msgstr "ಕ್ಲಾಸ್ ಹೆಸರು ಪೂರ್ವಪ್ರತ್ಯಯ"

#: src/admin/App.js:199
msgid "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter."
msgstr "ಪ್ಲಗಿನ್ ನಿಮ್ಮ ಪುಟಗಳಲ್ಲಿ ಮುದ್ರಿಸುವ ಪ್ರತಿಯೊಂದು ತರಗತಿಯ ಹೆಸರೂ ಈ ಪೂರ್ವಪ್ರತ್ಯಯದೊಂದಿಗೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಯಾವ ಪ್ಲಗಿನ್ ಅವುಗಳನ್ನು ನಿರ್ಮಿಸಿದೆ ಎಂಬುದನ್ನು ಪುಟಗಳು ಬಹಿರಂಗಪಡಿಸುವುದಿಲ್ಲ. ಅಕ್ಷರದಿಂದ ಪ್ರಾರಂಭಿಸಿ, 1 ರಿಂದ 8 ಲೋವರ್‌ಕೇಸ್ ಅಕ್ಷರಗಳು ಅಥವಾ ಅಂಕಿಗಳು."

#: src/admin/App.js:210
msgid "Beta updates"
msgstr "ಬೀಟಾ ನವೀಕರಣಗಳು"

#: src/admin/App.js:217
msgid "This site receives beta versions as updates."
msgstr "ಈ ಸೈಟ್ ನವೀಕರಣಗಳಾಗಿ ಬೀಟಾ ಆವೃತ್ತಿಗಳನ್ನು ಪಡೆಯುತ್ತದೆ."

#: src/admin/App.js:221
msgid "This site receives stable versions only."
msgstr "ಈ ಸೈಟ್ ಸ್ಥಿರ ಆವೃತ್ತಿಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ."

#: src/admin/App.js:230
msgid "Change this on the Account page"
msgstr "ಇದನ್ನು ಖಾತೆ ಪುಟದಲ್ಲಿ ಬದಲಾಯಿಸಿ"

#: src/admin/App.js:239
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "ಬೀಟಾ ಆವೃತ್ತಿಗಳನ್ನು ತಮ್ಮ ಖಾತೆಗೆ ಸಂಪರ್ಕಗೊಂಡಿರುವ ಪರವಾನಗಿ ಪಡೆದ ಪ್ರೊ ಅನುಸ್ಥಾಪನೆಗಳಿಗೆ ನೀಡಲಾಗುತ್ತದೆ. ಒಮ್ಮೆ ಸಂಪರ್ಕಗೊಂಡ ನಂತರ, ನೀವು ಖಾತೆ ಪುಟದಿಂದ ಸೇರಬಹುದು."

#: src/admin/App.js:255
msgid "Save settings"
msgstr "ಸಂಯೋಜನೆಗಳನ್ನು ಉಳಿಸಿ"

#: src/admin/Engines.js:87
msgid "First engine that is set up"
msgstr "ಮೊದಲ ಇಂಜಿನ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಲಾಗಿದೆ"

#: src/admin/Engines.js:110
msgid "Key saved. It is stored encrypted and never shown again."
msgstr "ಕೀಯನ್ನು ಉಳಿಸಲಾಗಿದೆ. ಇದನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ ಮತ್ತು ಮತ್ತೆಂದಿಗೂ ತೋರಿಸಲಾಗುವುದಿಲ್ಲ."

#: src/admin/Engines.js:120
msgid "Engine settings saved."
msgstr "ಎಂಜಿನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ."

#: src/admin/Engines.js:142
msgid "Glossary saved."
msgstr "ಶಬ್ದಕೋಶವನ್ನು ಉಳಿಸಲಾಗಿದೆ."

#: src/admin/Engines.js:163
msgid "Your keys"
msgstr "ನಿಮ್ಮ ಕೀಗಳು"

#: src/admin/Engines.js:165
msgid "Tranzly calls the translation services with your own account. Keys are stored encrypted in your database and are only ever sent to the service they belong to. AI model keys are set in the AI settings."
msgstr "Tranzly ನಿಮ್ಮ ಸ್ವಂತ ಖಾತೆಯೊಂದಿಗೆ ಅನುವಾದ ಸೇವೆಗಳನ್ನು ಕರೆಯುತ್ತದೆ. ಕೀಗಳನ್ನು ನಿಮ್ಮ ಡೇಟಾಬೇಸ್‌ನಲ್ಲಿ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಅವುಗಳಿಗೆ ಸೇರಿದ ಸೇವೆಗೆ ಮಾತ್ರ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. AI ಮಾದರಿ ಕೀಗಳನ್ನು AI ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಹೊಂದಿಸಲಾಗಿದೆ."

#. translators: %s: a translation service's name.
#: src/admin/Engines.js:183
#, js-format
msgid "%s API key"
msgstr "%s API ಕೀ"

