msgstr "Klicken Sie auf einen eingerahmten Text, um dessen Übersetzung zu korrigieren."

#: src/pro__premium_only/visual/index.js:109
msgid "No translated text was found on this page to edit here. Use the side-by-side editor instead."
msgstr "Auf dieser Seite wurde kein übersetzter Text zum Bearbeiten gefunden. Verwenden Sie stattdessen den nebeneinander angeordneten Editor."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Sprachumschalter"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Links zu dieser Seite in jeder Sprache der Website. Es wird nichts angezeigt, bis zwei oder mehr Sprachen aufgelistet sind."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Sprache"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "Wechsler"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "Übersetzung"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Ermöglicht Besuchern das Lesen dieser Seite in einer Ihrer anderen Sprachen: als Liste, Tabletts, Schaltflächen, Dropdown-Menü oder Sprachcodes, mit optionalen Flaggen."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "mehrsprachig"
