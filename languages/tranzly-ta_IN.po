msgstr "பின்னூட்டம் மற்றும் அம்சக் கோரிக்கைகள்"

#. translators: %s: request reference, e.g. ZT-ABC234.
#: src/admin-kit/Support.js:445
#, js-format
msgid "Sent. Your reference is %s, and our reply will come by e-mail."
msgstr "அனுப்பப்பட்டது. உங்கள் குறிப்பு %s ஆகும், மேலும் எங்கள் பதில் மின்னஞ்சல் மூலம் வரும்."

#: src/admin-kit/Support.js:465
msgid "What is it about?"
msgstr "இது எதைப் பற்றியது?"

#: src/admin-kit/Support.js:473
msgid "Reply to (e-mail)"
msgstr "(மின்னஞ்சல்) பதிலளிக்கவும்"

#: src/admin-kit/Support.js:485
msgid "Subject"
msgstr "பொருள்"

#: src/admin-kit/Support.js:493
msgid "What did you do, what did you expect, and what happened instead?"
msgstr "நீங்கள் என்ன செய்தீர்கள், நீங்கள் என்ன எதிர்பார்த்தீர்கள், அதற்குப் பதிலாக என்ன நடந்தது?"

#: src/admin-kit/Support.js:506
msgid "Include site details (versions, theme, plugins, error log excerpt)"
msgstr "தளம் தொடர்பான விவரங்களைச் சேர்க்கவும் (பதிப்புகள், தீம், செருகுநிரல்கள், பிழைப் பதிவுப் பகுதி)"

#: src/admin-kit/Support.js:523
msgid "See exactly what is sent"
msgstr "துல்லியமாக என்ன அனுப்பப்படுகிறது என்பதைப் பார்க்கவும்"

#: src/admin-kit/Support.js:530
msgid "Loading…"
msgstr "ஏற்றுகிறது…"

#: src/admin-kit/Support.js:536
msgid "Logins for support (optional, stored encrypted)"
msgstr "ஆதரவுக்கான உள்நுழைவுகள் (விருப்பத்தேர்வு, குறியாக்கம் செய்யப்பட்டு சேமிக்கப்படும்)"

#: src/admin-kit/Support.js:542
msgid "A login is only sent with its password. Leave a row out rather than half-filled."
msgstr "ஒரு உள்நுழைவு அதன் கடவுச்சொல்லுடன் மட்டுமே அனுப்பப்படும். பாதியாக நிரப்புவதை விட ஒரு வரியைத் தவிர்த்துவிடுங்கள்."

#: src/admin-kit/Support.js:560
msgid "Login address"
msgstr "உள்நுழைவு முகவரி"

#: src/admin-kit/Support.js:571
msgid "Username"
msgstr "பயனர் பெயர்"

#: src/admin-kit/Support.js:584
msgid "Password"
msgstr "கடவுச்சொல்"

#: src/admin-kit/Support.js:619
msgid "Add a login"
msgstr "உள்நுழைவைச் சேர்"

#: src/admin-kit/Support.js:626
msgid "Create a temporary support login"
msgstr "தற்காலிக ஆதரவு உள்நுழைவை உருவாக்கவும்"

#: src/admin-kit/Support.js:630
msgid "A separate user for our support team, without access to users, plugins installation or code editing. It is deleted automatically when it expires, or whenever you revoke it below."
msgstr "எங்கள் உதவிக்குழுவிற்கான தனிப் பயனர், பயனர்கள், செருகுநிரல் நிறுவல் அல்லது குறியீடு திருத்துவதற்கான அணுகல் இருக்காது. இது காலாவதியாகும்போதோ அல்லது கீழே நீங்கள் அதைத் திரும்பப் பெறும்போதுபோதோ தானாகவே நீக்கப்படும்."

#. translators: %d: number of days.
#: src/admin-kit/Support.js:645
#, js-format
msgid "Yes, for %d day"
msgid_plural "Yes, for %d days"
msgstr[0] "ஆம், %d நாட்களுக்கு"
msgstr[1] "ஆம், %d நாட்களுக்கு"

#: src/admin-kit/Support.js:669
msgid "Send"
msgstr "அனுப்பு"

#: src/admin-kit/Support.js:694
msgid "The list could not be loaded."
msgstr "ப்பட்டியலை ஏற்ற முடியவில்லை."

#: src/admin-kit/Support.js:709
msgid "That login could not be removed."
msgstr "அந்த உள்நுழைவுத் தகவலை அகற்ற முடியவில்லை."

#: src/admin-kit/Support.js:721
msgid "Temporary support logins"
msgstr "தற்காலிக ஆதரவு உள்நுழைவுகள்"

#: src/admin-kit/Support.js:733
msgid "None. Support can only log in to this site if you create a login here."
msgstr "எதுவுமில்லை. நீங்கள் இங்கு உள்நுழைவு ஒன்றை உருவாக்கினால் மட்டுமே ஆதரவுக் குழுவினரால் இந்தத் தளத்தில் உள்நுழைய முடியும்."

#: src/admin-kit/Support.js:745
msgid "expired, being removed"
msgstr "காலாவதியானது, அகற்றப்படுகிறது"

#. translators: %s: date and time.
#: src/admin-kit/Support.js:751
#, js-format
msgid "expires %s"
msgstr "காலாவதியாகும் தேதி %s"

#: src/admin-kit/Support.js:764
msgid "Revoke now"
msgstr "இப்போது ரத்து செய்"

#. translators: 1: this step, 2: number of steps.
#: src/admin-kit/Tour.js:98
#, js-format
msgid "Step %1$d of %2$d"
msgstr "படி %1$d இல் %2$d"

#: src/admin-kit/Tour.js:109
msgid "Close the tour"
msgstr "சுற்றுப்பயணத்தை மூடு"

#: src/admin-kit/Tour.js:116
#: src/admin-kit/Wizard.js:114
msgid "Back"
msgstr "பின்னால்"

#: src/admin-kit/tours.js:13
msgid "Everything in one place"
msgstr "அனைத்தும் ஒரே இடத்தில்"

#: src/admin-kit/tours.js:14
msgid "These tabs lead to every screen of the plugin: setup, settings, your licence, help and more."
msgstr "இந்தத் தாவல்கள் செருகுநிரலின் ஒவ்வொரு திரட்டிற்கும் உங்களை அழைத்துச் செல்லும்: அமைப்பு, அமைப்புகள், உங்கள் உரிமம், உதவி மற்றும் பல."

#: src/admin-kit/tours.js:21
msgid "Help on every screen"
msgstr "ஒவ்வொரு திரையிலும் உதவி"

#: src/admin-kit/tours.js:22
msgid "Open this menu for the guide to the screen you are on, this tour, or to ask us for help."
msgstr "நீங்கள் தற்போது இருக்கும் திரைக்கான வழிகாட்டி, இந்தச் சுற்றுப்பயணம் அல்லது எங்களிடம் உதவி கேட்க இந்த மெனுவைத் திறக்கவும்."

#: src/admin-kit/tours.js:29
msgid "Light or dark"
msgstr "வெளிர் அல்லது இருள்"

#: src/admin-kit/tours.js:30
msgid "Choose light, dark, or the same as your computer. Your choice is remembered for you only."
msgstr "வெளுப்பு, கருப்பு அல்லது உங்கள் கணினியைப் போன்றே என்பதைத் தேர்ந்தெடுக்கவும். உங்கள் தேர்வு உங்களுக்காக மட்டுமே நினைவில் கொள்ளப்படும்."

#: src/admin-kit/tours.js:39
#: src/admin-kit/Wizard.js:41
msgid "Welcome"
msgstr "வரவேற்கிறோம்"

#: src/admin-kit/tours.js:40
msgid "This short tour shows where things are. You can leave it at any time with Escape."
msgstr "இந்தச் சுருக்கமான சுற்றுலா எங்கு என்ன இருக்கிறது என்பதைக் காட்டுகிறது. Escape-ஐ அழுத்தி நீங்கள் எப்போது வேண்டுமானாலும் இதை விட்டு வெளியேறலாம்."

#: src/admin-kit/tours.js:48
msgid "Your site at a glance"
msgstr "உங்கள் தளம் ஒரே பார்வையில்"

#: src/admin-kit/tours.js:49
msgid "Setup progress and your plan are shown here, with the next thing worth doing."
msgstr "அமைவு முன்னேற்றமும் உங்கள் திட்டமும் இங்கே காட்டப்பட்டுள்ளன, அடுத்து செய்ய வேண்டிய முக்கியமான பணியுடன்."

#: src/admin-kit/tours.js:61
msgid "Your plan, how many sites it covers, and whether this copy of the site counts toward that limit."
msgstr "உங்கள் திட்டம், அது எத்தனை தளங்களை உள்ளடக்கியது மற்றும் தளத்தின் இந்த நகல் அந்த வரம்பில் கணக்கிடப்படுமா இல்லையா என்பது."

#: src/admin-kit/tours.js:68
msgid "Try Pro or upgrade"
msgstr "ப்ரோவை முயற்சிக்கவும் அல்லது மேம்படுத்தவும்"

#: src/admin-kit/tours.js:69
msgid "Start a free trial without a card, upgrade, or renew, all from here."
msgstr "கார்டு இல்லாமலேயே இலவச சோதனையைத் தொடங்குங்கள், மேம்படுத்துங்கள் அல்லது புதுப்பிக்குங்கள், அனைத்தும் இங்கிருந்தே."

#: src/admin-kit/tours.js:77
msgid "Every feature and the plan that includes it. Search for a feature or show one area at a time."
msgstr "ஒவ்வொரு அம்சமும் அதை உள்ளடக்கிய திட்டமும். ஒரு அம்சத்தைத் தேடுங்கள் அல்லது ஒரு நேரத்தில் ஒரு பகுதியைக் காட்டுங்கள்."

#: src/admin-kit/tours.js:86
msgid "More from Zinn Digital®"
msgstr "Zinn Digital® இலிருந்து மேலும்"

#: src/admin-kit/tours.js:87
msgid "Plugins that work with this one, and services from the same team. Cards you hid on other screens can be shown again here."
msgstr "இதனுடன் வேலை செய்யும் செருகுநிரல்கள் மற்றும் அதே குழுவின் சேவைகள். பிற திரைகளில் நீங்கள் மறைத்த அட்டைகளை இங்கு மீண்டும் காட்டலாம்."

#: src/admin-kit/tours.js:96
msgid "Connect for faster help"
msgstr "துரித உதவிக்கு இணைக்கவும்"

#: src/admin-kit/tours.js:97
msgid "Connecting is optional. It lets you send requests without typing your e-mail each time, and you can disconnect whenever you like."
msgstr "இணைப்பது விருப்பத்திற்குரியது. இது ஒவ்வொரு முறையும் உங்கள் மின்னஞ்சலைத் தட்டச்சு செய்யாமல் கோரிக்கைகளை அனுப்ப உங்களை அனுமதிக்கிறது, மேலும் நீங்கள் விரும்பும் போதெல்லாம் துண்டிக்கலாம்."

#: src/admin-kit/tours.js:104
msgid "Ask for help or report a bug"
msgstr "உதவி கேளுங்கள் அல்லது பிழையைப் புகாரளியுங்கள்"

#: src/admin-kit/tours.js:105
msgid "Describe what happened. You choose whether to attach site information, and you can see exactly what it contains first."
msgstr "என்ன நடந்தது என்பதை விவரிக்கவும். தளம் தொடர்பான தகவல்களை இணைக்கலாமா வேண்டாமா என்பதை நீங்களே தேர்வு செய்யலாம், மேலும் அதில் என்ன இருக்கிறது என்பதை முன்கூட்டியே துல்லியமாகப் பார்த்துக்கொள்ளலாம்."

#: src/admin-kit/tours.js:112
msgid "Temporary support access"
msgstr "தற்காலிக ஆதரவு அணுகல்"

#: src/admin-kit/tours.js:113
msgid "If support needs to look inside your site, create a temporary login here. It deletes itself when it expires, and you can remove it at any time."
msgstr "உதவிக் குழு உங்கள் தளத்திற்குள் பார்க்க வேண்டியிருந்தால், இங்கே தற்காலிக உள்நுழைவை உருவாக்கவும். அது காலாவதியாகும் போது தானாகவே நீக்கப்படும், மேலும் எப்போது வேண்டுமானாலும் அதை நீங்கள் அகற்றலாம்."

#: src/admin-kit/tours.js:122
msgid "Tell us what to build"
msgstr "நாங்கள் என்ன உருவாக்க வேண்டும் என்பதை எங்களிடம் கூறுங்கள்"

#: src/admin-kit/tours.js:123
msgid "Send an idea, a feature request or any feedback. It goes straight to the team."
msgstr "ஒரு யோசனை, அம்சக் கோரிக்கை அல்லது ஏதேனும் கருத்துகளை அனுப்பவும். இது நேரடியாகக் குழுவைச் சென்று சேரும்."

#. translators: %s: plugin name.
#: src/admin-kit/Wizard.js:46
#, js-format
msgid "This takes a few minutes and sets up %s so it works on this site straight away. You can change everything later."
msgstr "இதற்கு சில நிமிடங்கள் ஆகும் மற்றும் இந்தத் தளத்தில் உடனடியாக வேலை செய்ய %s ஐ இது அமைக்கிறது. நீங்கள் எல்லாவற்றையும் பின்னர் மாற்றிக் கொள்ளலாம்."

#: src/admin-kit/Wizard.js:62
msgid "You are ready. If anything does not work as expected, we are one click away."
msgstr "நீங்கள் தயாராக உள்ளீர்கள். எதுவும் எதிர்பார்த்தபடி செயல்படவில்லை என்றால், ஒரே கிளிக்கில் எங்களைத் தொடர்புகொள்ளலாம்."

#. translators: 1: step number, 2: number of steps, 3: step title.
#: src/admin-kit/Wizard.js:89
#, js-format
msgid "Step %1$d of %2$d: %3$s"
msgstr "படி %1$d முதல் %2$d வரை: %3$s"

#: src/admin-kit/Wizard.js:119
msgid "Finish"
msgstr "நிறைவு செய்"

#: src/admin-kit/Wizard.js:131
msgid "Skip setup"
msgstr "அமைப்பைத் தவிர்"

#. zinn-i18n: human translation — a person corrected the machine translation
#: src/admin/About.js:17
msgid "Built by Neil Lock, CEO of Zinn Digital® Ltd"
msgstr "Zinn Digital® Ltd-ன் தலைமை நிர்வாக அதிகாரி Neil Lock என்பவரால் உருவாக்கப்பட்டது"

#. translators: %s: plugin version number.
#: src/admin/About.js:25
#, js-format
msgid "Version %s"
msgstr "பதிப்பு %s"

