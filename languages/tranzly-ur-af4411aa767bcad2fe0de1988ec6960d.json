            "See the Pro plans and pricing": [
                "Pro \u067e\u0644\u0627\u0646\u0632 \u0627\u0648\u0631 \u0642\u06cc\u0645\u062a\u06cc\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba"
