#, js-format
msgid "Saved: %s. Enter a new key to replace it, or save an empty field to remove it."
msgstr "Сохранено: %s. Введите новый ключ для замены или оставьте поле пустым для удаления."

#: src/admin/Engines.js:196
msgid "No key saved."
msgstr "Ключ не сохранен."

#: src/admin/Engines.js:209
msgid "Azure region (leave empty for a global resource)"
msgstr "Регион Azure (оставьте пустым для глобального ресурса)"

#: src/admin/Engines.js:223
msgid "Save key"
msgstr "Сохранить ключ"

#: src/admin/Engines.js:231
msgid "Check my DeepL usage"
msgstr "Проверить использование DeepL"

#. translators: 1: characters used, 2: the account's limit.
#: src/admin/Engines.js:241
#, js-format
msgid "%1$s of %2$s characters used this billing period."
msgstr "Использовано %1$s из %2$s символов в этом расчетном периоде."

#: src/admin/Engines.js:255
msgid "Which engine translates"
msgstr "Какой движок переводит"

#: src/admin/Engines.js:260
msgid "No engine is set up yet. Save a key above (or set up an AI model) to start translating."
msgstr "Движок еще не настроен. Сохраните ключ выше (или настройте модель ИИ), чтобы начать перевод."

#: src/admin/Engines.js:268
msgid "Default engine"
msgstr "Движок по умолчанию"

#: src/admin/Engines.js:277
msgid "A different engine per language, automatic fallback and monthly spending caps are Tranzly Pro features."
msgstr "Отдельный движок для каждого языка, автоматическое резервное копирование и ежемесячные лимиты расходов являются функциями Tranzly Pro."

#. translators: %s: a language name.
#: src/admin/Engines.js:290
#, js-format
msgid "Engine for %s"
msgstr "Движок для %s"

#: src/admin/Engines.js:299
msgid "The default engine"
msgstr "Основной движок"

#: src/admin/Engines.js:320
msgid "If an engine fails or reaches a limit, try these next, in this order"
msgstr "Если двигатель вышел из строя или достиг предела, попробуйте выполнить следующие действия в указанном порядке"

#: src/admin/Engines.js:353
msgid "Monthly spending caps"
msgstr "Лимиты ежемесячных расходов"

#: src/admin/Engines.js:357
msgid "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap."
msgstr "Когда движок достигает своего лимита, в него больше ничего не отправляется до следующего месяца, а в отчете о неудачных переводах указана причина. Оставьте поле пустым, чтобы не устанавливать лимит."

#. translators: 1: an engine's name, 2: dollars spent this month.
#: src/admin/Engines.js:371
#, js-format
msgid "%1$s (spent this month: $%2$s)"
msgstr "%1$s (потрачено в этом месяце: $%2$s)"

#: src/admin/Engines.js:400
msgid "Save caps"
msgstr "Сохранить лимиты"

#: src/admin/Engines.js:407
msgid "Glossary and words never translated"
msgstr "Глоссарий и слова, которые никогда не переводятся"

#: src/admin/Engines.js:415
msgid "Never translate these words (one per line)"
msgstr "Никогда не переводите эти слова (по одному в строке)"

#: src/admin/Engines.js:419
msgid "Brand and product names stay exactly as they are, with every engine."
msgstr "Названия брендов и продуктов остаются неизменными для любого движка."

#: src/admin/Engines.js:430
msgid "Preferred translations and tone per language are Tranzly Pro features."
msgstr "Предпочтительные варианты перевода и тон для каждого языка доступны в Tranzly Pro."

#: src/admin/Engines.js:445
msgid "Preferred translations (one per line: term = translation)"
msgstr "Предпочтительные варианты (по одному на строку: термин = перевод)"

#: src/admin/Engines.js:465
msgid "Formality"
msgstr "Формальность"

#: src/admin/Engines.js:473
msgid "Default"
msgstr "По умолчанию"

#: src/admin/Engines.js:480
msgid "Formal"
msgstr "Официальный"

#: src/admin/Engines.js:487
msgid "Informal"
msgstr "Неофициальный"

