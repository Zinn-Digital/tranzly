            "Not translated yet": [
                "\u0905\u0926\u094d\u092f\u093e\u092a \u092d\u093e\u0937\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940"
            ],
            "Saved. The pieces you changed are marked as checked by a person, and this translation is protected from machine translation.": [
                "\u091c\u0924\u0928 \u0915\u0947\u0932\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u092c\u0926\u0932\u0932\u0947\u0932\u0947 \u092d\u093e\u0917 \u090f\u0916\u093e\u0926\u094d\u092f\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0928\u0947 \u0924\u092a\u093e\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u091a\u093f\u0928\u094d\u0939\u093e\u0902\u0915\u093f\u0924 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947\u0924, \u0906\u0923\u093f \u0939\u0947 \u092d\u093e\u0937\u093e\u0902\u0924\u0930 \u092e\u0936\u0940\u0928 \u092d\u093e\u0937\u093e\u0902\u0924\u0930\u093e\u092a\u093e\u0938\u0942\u0928 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947."
            ],
            "The layout of this translation was changed in the editor, so some pieces no longer pair with the original. Pieces without a partner are shown empty; edit the rest in the editor.": [
                "\u092f\u093e \u092d\u093e\u0937\u093e\u0902\u0924\u0930\u093e\u091a\u0940 \u0930\u091a\u0928\u093e \u0938\u0902\u092a\u093e\u0926\u0915\u093e\u092e\u0927\u094d\u092f\u0947 \u092c\u0926\u0932\u0932\u0940 \u0917\u0947\u0932\u0940 \u0939\u094b\u0924\u0940, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0915\u093e\u0939\u0940 \u092d\u093e\u0917 \u0906\u0924\u093e \u092e\u0942\u0933 \u092d\u093e\u0917\u093e\u0936\u0940 \u091c\u0941\u0933\u0924 \u0928\u093e\u0939\u0940\u0924. \u091c\u094b\u0921\u0940 \u0928\u0938\u0932\u0947\u0932\u0947 \u092d\u093e\u0917 \u0930\u093f\u0915\u093e\u092e\u0947 \u0926\u093e\u0916\u0935\u0932\u0947 \u0906\u0939\u0947\u0924; \u0909\u0930\u094d\u0935\u0930\u093f\u0924 \u092d\u093e\u0917 \u0938\u0902\u092a\u093e\u0926\u0915\u093e\u092e\u0927\u094d\u092f\u0947 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e."
            ],
            "Open the editor": [
                "\u0938\u0902\u092a\u093e\u0926\u0915 \u0909\u0918\u0921\u093e"
            ],
            "Original (%s)": [
                "\u092e\u0942\u0933 (%s)"
            ],
            "Translation (%s)": [
                "\u092d\u093e\u0937\u093e\u0902\u0924\u0930 (%s)"
            ],
            "This piece has formatting or links, so it is shown with its HTML. Change only the words between the tags.": [
                "\u092f\u093e \u092d\u093e\u0917\u093e\u092e\u0927\u094d\u092f\u0947 \u0938\u094d\u0935\u0930\u0942\u092a\u0928 \u0915\u093f\u0902\u0935\u093e \u0932\u093f\u0902\u0915\u094d\u0938 \u0906\u0939\u0947\u0924, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0924\u094b \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e HTML \u0938\u0939 \u0926\u093e\u0916\u0935\u0932\u093e \u0906\u0939\u0947. \u092b\u0915\u094d\u0924 \u091f\u0945\u0917 \u0926\u0930\u092e\u094d\u092f\u093e\u0928\u091a\u0947 \u0936\u092c\u094d\u0926 \u092c\u0926\u0932\u093e."
            ],
