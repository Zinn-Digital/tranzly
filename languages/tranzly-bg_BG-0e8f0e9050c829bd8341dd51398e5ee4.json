            "Style instructions (audience, brand voice)": [
                "\u0418\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0437\u0430 \u0441\u0442\u0438\u043b (\u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044f, \u0433\u043b\u0430\u0441 \u043d\u0430 \u043c\u0430\u0440\u043a\u0430\u0442\u0430)"
