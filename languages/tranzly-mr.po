#, js-format
msgid "Address word for %s"
msgstr "%s साठी पत्ता शब्द"

#: src/admin/Urls.js:133
msgid "The default language has no word in its addresses."
msgstr "डिफॉल्ट भाषेच्या पत्त्यांमध्ये कोणताही शब्द नाही."

#. translators: %s: a language code such as de_DE.
#: src/admin/Urls.js:157
#, js-format
msgid "Domain for %s (optional)"
msgstr "%s साठी डोमेन (पर्यायी)"

#: src/admin/Urls.js:160
msgid "Point the domain at this site first. A language with no domain uses a folder on your main domain."
msgstr "पहिले डोमेन या साइटवर निर्देशित करा. डोमेन नसलेली भाषा तुमच्या मुख्य डोमेनवरील फोल्डर वापरते."

#: src/admin/Urls.js:176
msgid "Where each language lives now"
msgstr "प्रत्येक भाषा आता कुठे राहते"

#: src/admin/Urls.js:192
msgid "Translated address words"
msgstr "अनुवादित पत्त्याचे शब्द"

#: src/admin/Urls.js:196
msgid "Page and post addresses come from their translated titles. Here you translate the fixed words, so /de/kategorie/ replaces /de/category/."
msgstr "पेजेस आणि पोस्टचे पत्ते त्यांच्या भाषांतरित शीर्षकांवरून येतात. इथे तुम्ही निश्चित शब्दांचे भाषांतर करता, त्यामुळे /de/category/ ऐवजी /de/kategorie/ येते."

#. translators: 1: what the word is for (Category), 2: the word WordPress uses now.
#: src/admin/Urls.js:213
#, js-format
msgid "%1$s (now “%2$s”)"
msgstr "%1$s (आता \"%2$s\")"

#: src/admin/Urls.js:245
msgid "Search engines and visitors"
msgstr "शोध यंत्रे आणि अभ्यागत"

#: src/admin/Urls.js:250
msgid "Offer visitors their own language with a small banner (never a redirect)"
msgstr "अभ्यागतांना लहान बॅनर्ससह त्यांची स्वतःची भाषा ऑफर करा (कधीही पुनर्निर्देशन नाही)"

#: src/admin/Urls.js:259
msgid "Hide untranslated pages from search engines (noindex)"
msgstr "अभाषिक पृष्ठे शोध इंजिनांपासून लपवा (noindex)"

#: src/admin/Urls.js:265
msgid "A translation that still holds the original text is kept out of search results until it is translated."
msgstr "मूळ मजकूर जसाच्या तसा ठेवणारे भाषांतर, ते पूर्ण होईपर्यंत शोध परिणामांमधून वगळले जाते."

#: src/admin/Urls.js:269
msgid "Part of Tranzly Pro."
msgstr "Tranzly Pro चा भाग."

#: src/admin/Urls.js:278
msgid "Tranzly adds hreflang links (with x-default), the page language and direction, and every language to your sitemap:"
msgstr "Tranzly हे तुमच्या साइटमॅपमध्ये hreflang लिंक्स (x-default सह), पेजची भाषा आणि दिशा आणि प्रत्येक भाषा जोडते:"

#. translators: %s: names of SEO plugins, such as Yoast SEO.
#: src/admin/Urls.js:292
#, js-format
msgid "Working together with: %s."
msgstr "%s च्या सहकार्याने कार्य करत आहे."

#: src/admin/Urls.js:309
msgid "Each address word is 2 to 12 lowercase letters, digits or hyphens."
msgstr "प्रत्येक पत्त्याचा शब्द हा २ ते १२ लहान अक्षरे, अंक किंवा हायफनचा असतो."

#: src/editor/index.js:18
#: src/editor/switcher.js:28
msgid "Add a second language under Tranzly in the admin menu, and the switcher appears here."
msgstr "प्रशासन मेनूमध्ये Tranzly अंतर्गत दुसरी भाषा जोडा, आणि स्विच येथे दिसेल."

#: src/editor/switcher.js:67
msgid "Off by default: a flag is a country, not a language."
msgstr "डीफॉल्टनुसार बंद: ध्वज हा देश आहे, भाषा नाही."

#: src/editor/switcher.js:108
msgid "What screen readers announce, for example “Choose a language”."
msgstr "स्क्रीन रीडर जे वाचून दाखवतात, उदाहरणार्थ \"भाषा निवडा\"."

