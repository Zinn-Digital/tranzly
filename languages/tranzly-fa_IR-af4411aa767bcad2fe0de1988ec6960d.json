            ],
            "No engine is set up yet. Save a key above (or set up an AI model) to start translating.": [
                "\u0647\u0646\u0648\u0632 \u0647\u06cc\u0686 \u0645\u0648\u062a\u0648\u0631\u06cc \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0631\u0627\u06cc \u0634\u0631\u0648\u0639 \u062a\u0631\u062c\u0645\u0647\u060c \u06cc\u06a9 \u06a9\u0644\u06cc\u062f \u0631\u0627 \u062f\u0631 \u0628\u0627\u0644\u0627 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u06cc\u062f (\u06cc\u0627 \u06cc\u06a9 \u0645\u062f\u0644 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0631\u0627 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u06a9\u0646\u06cc\u062f)."
            ],
            "Default engine": [
                "\u0645\u0648\u062a\u0648\u0631 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636"
            ],
            "A different engine per language, automatic fallback and monthly spending caps are Tranzly Pro features.": [
                "\u06cc\u06a9 \u0645\u0648\u062a\u0648\u0631 \u062a\u0631\u062c\u0645\u0647 \u0645\u062a\u0641\u0627\u0648\u062a \u0628\u0631\u0627\u06cc \u0647\u0631 \u0632\u0628\u0627\u0646\u060c \u0628\u0627\u0632\u06af\u0634\u062a \u062e\u0648\u062f\u06a9\u0627\u0631 \u0628\u0647 \u0632\u0628\u0627\u0646 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u0648 \u0633\u0642\u0641 \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0645\u0627\u0647\u0627\u0646\u0647 \u0627\u0632 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0646\u0633\u062e\u0647 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc Tranzly \u0647\u0633\u062a\u0646\u062f."
            ],
            "Engine for %s": [
                "\u0645\u0648\u062a\u0648\u0631 \u0628\u0631\u0627\u06cc %s"
            ],
            "The default engine": [
                "\u0645\u0648\u062a\u0648\u0631 \u067e\u06cc\u0634\u200c\u0641\u0631\u0636"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u0627\u06af\u0631 \u0645\u0648\u062a\u0648\u0631 \u0627\u0632 \u06a9\u0627\u0631 \u0627\u0641\u062a\u0627\u062f \u06cc\u0627 \u0628\u0647 \u062d\u062f \u0646\u0635\u0627\u0628 \u0631\u0633\u06cc\u062f\u060c \u0627\u06cc\u0646 \u0645\u0648\u0627\u0631\u062f \u0631\u0627 \u0628\u0647 \u062a\u0631\u062a\u06cc\u0628 \u0632\u06cc\u0631 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f"
            ],
            "Monthly spending caps": [
