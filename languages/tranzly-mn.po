#: src/pro__premium_only/visual/index.js:109
msgid "No translated text was found on this page to edit here. Use the side-by-side editor instead."
msgstr "Энэ хуудаснаас энд за засварлах орчуулсан текст олдсонгүй. Үүний оронд хажуу талын зэрэгцүүлсэн засварлагчийг ашиглана уу."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Хэл солигч"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Энэ сайтын хэл тус бүрээр энэ хуудас руу холбох холбоосууд. Хоёр буюу түүнээс дээш хэл жагсаагдах хүртэл юу ч харуулахгүй."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Хэл"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "соlигч"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "орtүүлэх"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Зочдод энэ хуудсыг таны бусад хэлний аль нэгээр нь унших боломжийг олгоно: жагсаалт, таблет, товчлуур, унадаг цэс эсвэл хэлний код, сонголтоор туг дүрс."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "олон хэлтэй"
