            ],
            "Azure region (leave empty for a global resource)": [
                "\u0645\u0646\u0637\u0642\u0647 Azure (\u0628\u0631\u0627\u06cc \u06cc\u06a9 \u0645\u0646\u0628\u0639 \u062c\u0647\u0627\u0646\u06cc \u062e\u0627\u0644\u06cc \u0628\u06af\u0630\u0627\u0631\u06cc\u062f)"
