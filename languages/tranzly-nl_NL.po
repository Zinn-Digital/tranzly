msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Links naar deze pagina in elke taal van de website. Dit geeft niets weer totdat er twee of meer talen worden vermeld."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Taal"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "omschakelaar"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "vertaling"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Laat bezoekers deze pagina in een andere taal van u lezen: een lijst, pillen, knoppen, een dropdown of taalcode, met optionele vlaggen."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "meertalig"
