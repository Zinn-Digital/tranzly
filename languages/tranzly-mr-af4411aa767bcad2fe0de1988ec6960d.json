            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u092a\u094d\u0932\u0945\u0917\u0907\u0928 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0902\u0935\u0930 \u091b\u093e\u092a\u093e\u092f\u091a\u0947 \u0905\u0938\u0932\u0947\u0932\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0915\u094d\u0932\u093e\u0938 \u0928\u093e\u0935 \u092f\u093e \u0909\u092a\u0938\u0930\u094d\u0917\u093e\u0928\u0947 (prefix) \u0938\u0941\u0930\u0942 \u0939\u094b\u0924\u0947, \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u092a\u0943\u0937\u094d\u0920\u0947 \u0939\u0947 \u0909\u0918\u0921 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940\u0924 \u0915\u0940 \u0924\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u092a\u094d\u0932\u0945\u0917\u0907\u0928\u0928\u0947 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947\u0924. \u0905\u0915\u094d\u0937\u0930\u093e\u0928\u0947 \u0938\u0941\u0930\u0942 \u0939\u094b\u0923\u093e\u0930\u0940, 1 \u0924\u0947 8 \u091b\u094b\u091f\u0940 \u0905\u0915\u094d\u0937\u0930\u0947 \u0915\u093f\u0902\u0935\u093e \u0905\u0902\u0915."
            ],
            "Beta updates": [
                "\u092c\u0940\u091f\u093e \u0905\u092a\u0921\u0947\u091f\u094d\u0938"
