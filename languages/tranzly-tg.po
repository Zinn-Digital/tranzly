msgstr "Номи дақиқи моделро ворид кунед, масалан, тавре ки дар ҳуҷҷатгузории таъминкунанда навишта шудааст."

#. translators: %s: model name.
#: includes/ai-core/class-admin.php:772
#, php-format
msgid "Added %s. Choose it under \"Which model to use\"."
msgstr "%s илова шуд. Онро дар зери \"Кадом моделро истифода бурдан лозим аст\" интихоб кунед."

#: includes/ai-core/class-admin.php:801
msgid "Model removed."
msgstr "Модел хориҷ карда шуд."

