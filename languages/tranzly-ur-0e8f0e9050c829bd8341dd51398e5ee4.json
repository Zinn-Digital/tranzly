            "Engine for %s": [
                "%s \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u062c\u0646"
            ],
            "The default engine": [
                "\u0637\u06d2 \u0634\u062f\u06c1 \u0627\u0646\u062c\u0646"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u0627\u06af\u0631 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062c\u0646 \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u06cc\u0627 \u062d\u062f \u062a\u06a9 \u067e\u06c1\u0646\u0686 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0627\u0646 \u06a9\u0648 \u0627\u0633 \u062a\u0631\u062a\u06cc\u0628 \u0645\u06cc\u06ba \u0622\u0632\u0645\u0627\u0626\u06cc\u06ba"
            ],
            "Monthly spending caps": [
                "\u0645\u0627\u06c1\u0627\u0646\u06c1 \u0627\u062e\u0631\u0627\u062c\u0627\u062a \u06a9\u06cc \u062d\u062f\u06cc\u06ba"
            ],
            "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap.": [
                "\u062c\u0628 \u06a9\u0648\u0626\u06cc \u0627\u0646\u062c\u0646 \u0627\u067e\u0646\u06cc \u062d\u062f \u062a\u06a9 \u067e\u06c1\u0646\u0686 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0627\u06af\u0644\u06d2 \u0645\u06c1\u06cc\u0646\u06d2 \u062a\u06a9 \u0627\u0633\u06d2 \u0645\u0632\u06cc\u062f \u06a9\u0686\u06be \u0646\u06c1\u06cc\u06ba \u0628\u06be\u06cc\u062c\u0627 \u062c\u0627\u062a\u0627 \u0627\u0648\u0631 \u0646\u0627\u06a9\u0627\u0645 \u062a\u0631\u062c\u0645\u06d2 \u06a9\u06cc \u0631\u067e\u0648\u0631\u0679 \u0627\u0633 \u06a9\u06cc \u0648\u062c\u06c1 \u0628\u062a\u0627\u062a\u06cc \u06c1\u06d2\u06d4 \u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u062d\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0627\u0644\u06cc \u0686\u06be\u0648\u0691 \u062f\u06cc\u06ba\u06d4"
            ],
            "%1$s (spent this month: $%2$s)": [
                "%1$s (\u0627\u0633 \u0645\u06c1\u06cc\u0646\u06d2 \u062e\u0631\u0686 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2: $%2$s)"
            ],
            "Save caps": [
                "\u0635\u0644\u0627\u062d\u06cc\u062a\u06cc\u06ba \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba"
            ],
            "Preferred translations (one per line: term = translation)": [
                "\u062a\u0631\u062c\u06cc\u062d\u06cc \u062a\u0631\u0627\u062c\u0645 (\u0641\u06cc \u0633\u0637\u0631 \u0627\u06cc\u06a9: \u0627\u0635\u0637\u0644\u0627\u062d = \u062a\u0631\u062c\u0645\u06c1)"
            ],
            "Formality": [
                "\u0631\u0633\u0645\u06cc\u062a"
            ],
            "Default": [
                "\u0688\u06cc\u0641\u0627\u0644\u0679"
            ],
            "Formal": [
                "\u0631\u0633\u0645\u06cc"
            ],
            "Informal": [
                "\u063a\u06cc\u0631 \u0631\u0633\u0645\u06cc"
            ],
            "Style instructions (audience, brand voice)": [
                "\u0627\u0646\u062f\u0627\u0632 \u06a9\u06cc \u06c1\u062f\u0627\u06cc\u0627\u062a (\u0633\u0627\u0645\u0639\u06cc\u0646\u060c \u0628\u0631\u0627\u0646\u0688 \u06a9\u0627 \u0644\u06c1\u062c\u06c1)"
            ]
        }
    }
