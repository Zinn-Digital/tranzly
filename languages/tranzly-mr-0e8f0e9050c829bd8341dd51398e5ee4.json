            "Engine for %s": [
                "%s \u0938\u093e\u0920\u0940 \u0907\u0902\u091c\u093f\u0928"
            ],
            "The default engine": [
                "\u0921\u0940\u092b\u0949\u0932\u094d\u091f \u0907\u0902\u091c\u093f\u0928"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u0907\u0902\u091c\u093f\u0928 \u0905\u092f\u0936\u0938\u094d\u0935\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u092e\u0930\u094d\u092f\u093e\u0926\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094b\u0939\u094b\u091a\u0932\u094d\u092f\u093e\u0938, \u092f\u093e \u0915\u094d\u0930\u092e\u093e\u0928\u0947 \u092a\u0941\u0922\u0940\u0932 \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e"
            ],
            "Monthly spending caps": [
                "\u092e\u093e\u0938\u093f\u0915 \u0916\u0930\u094d\u091a \u092e\u0930\u094d\u092f\u093e\u0926\u093e"
            ],
            "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap.": [
                "\u091c\u0947\u0935\u094d\u0939\u093e \u0907\u0902\u091c\u093f\u0928 \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092e\u0930\u094d\u092f\u093e\u0926\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u092a\u094b\u0939\u094b\u091a\u0924\u0947, \u0924\u0947\u0935\u094d\u0939\u093e \u092a\u0941\u0922\u0940\u0932 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u092a\u0930\u094d\u092f\u0902\u0924 \u0924\u094d\u092f\u093e\u0932\u093e \u0906\u0923\u0916\u0940 \u0915\u093e\u0939\u0940\u0939\u0940 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0905\u092f\u0936\u0938\u094d\u0935\u0940 \u092d\u093e\u0937\u093e\u0902\u0924\u0930 \u0905\u0939\u0935\u093e\u0932 \u0924\u094d\u092f\u093e\u091a\u0947 \u0915\u093e\u0930\u0923 \u0938\u093e\u0902\u0917\u0924\u094b. \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092e\u0930\u094d\u092f\u093e\u0926\u093e \u0928 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0930\u093f\u0915\u094d\u0924 \u0920\u0947\u0935\u093e."
            ],
            "%1$s (spent this month: $%2$s)": [
                "%1$s (\u092f\u093e \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0924 \u0916\u0930\u094d\u091a \u091d\u093e\u0932\u0947: $%2$s)"
            ],
            "Save caps": [
                "\u0915\u094d\u0937\u092e\u0924\u093e \u091c\u0924\u0928 \u0915\u0930\u093e"
            ],
            "Preferred translations (one per line: term = translation)": [
                "\u092a\u094d\u0930\u093e\u0927\u093e\u0928\u094d\u092f \u0926\u093f\u0932\u0947\u0932\u0940 \u092d\u093e\u0937\u093e\u0902\u0924\u0930\u0947 (\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0913\u0933\u0940\u0924 \u090f\u0915: \u0938\u0902\u091c\u094d\u091e\u093e = \u092d\u093e\u0937\u093e\u0902\u0924\u0930)"
            ],
            "Formality": [
