            ],
            "Style instructions (audience, brand voice)": [
                "\u0936\u0948\u0932\u0940 \u0938\u0942\u091a\u0928\u093e (\u0932\u0915\u094d\u0937\u094d\u092f\u093f\u0924 \u0917\u091f, \u092c\u094d\u0930\u0901\u0921\u091a\u093e \u0906\u0935\u093e\u091c)"
