msgstr "Використати оригінальне зображення"

#: src/pro__premium_only/visual/index.js:17
#: src/pro__premium_only/visual/index.js:19
msgid "Correct this translation"
msgstr "Виправити цей переклад"

#: src/pro__premium_only/visual/index.js:45
