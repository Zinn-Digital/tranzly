msgstr "មតិកែលម្អ និងសំណើមុខងារថ្មីៗ"

#. translators: %s: request reference, e.g. ZT-ABC234.
#: src/admin-kit/Support.js:445
#, js-format
msgid "Sent. Your reference is %s, and our reply will come by e-mail."
msgstr "ការបញ្ជូន។ ឯកសារយោងរបស់អ្នកគឺ %s ហើយចម្លើយរបស់យើងនឹងត្រូវផ្ញើតាមអ៊ីមែល។"

#: src/admin-kit/Support.js:465
msgid "What is it about?"
msgstr "តើវាអំពីអ្វី?"

#: src/admin-kit/Support.js:473
msgid "Reply to (e-mail)"
msgstr "ឆ្លើយតបទៅ (អ៊ីមែល)"

#: src/admin-kit/Support.js:485
msgid "Subject"
msgstr "ប្រធានបទ"

#: src/admin-kit/Support.js:493
msgid "What did you do, what did you expect, and what happened instead?"
msgstr "តើអ្នកបានធ្វើអ្វី តើអ្នករំពឹងអ្វី ហើយតើមានអ្វីកើតឡើងជំនួសវិញ?"

#: src/admin-kit/Support.js:506
msgid "Include site details (versions, theme, plugins, error log excerpt)"
msgstr "រួមបញ្ចូលព័ត៌មានលម្អិតអំពីគេហទំព័រ (កំណែ, ប្រធានបទ, កម្មវិធីជំនួយ, កំណត់ហេតុបញ្ហាខុស)"

#: src/admin-kit/Support.js:523
msgid "See exactly what is sent"
msgstr "មើលឱ្យច្បាស់នូវអ្វីដែលត្រូវបានបញ្ជូន"

#: src/admin-kit/Support.js:530
msgid "Loading…"
msgstr "កំពុងផ្ទុក..."

#: src/admin-kit/Support.js:536
msgid "Logins for support (optional, stored encrypted)"
msgstr "ព័ត៌មានសម្ងាត់សម្រាប់ចូលជំនួយ (ជាជម្រើស, រក្សាទុកដោយអ៊ិនគ្រីប)"

#: src/admin-kit/Support.js:542
msgid "A login is only sent with its password. Leave a row out rather than half-filled."
msgstr "ការចូលប្រព័ន្ធត្រូវបានបញ្ជូនមកជាមួយតែពាក្យសម្ងាត់របស់វាប៉ុណ្ណោះ។ សូមទុកជួរដេកមួយចោលប្រសិនបើវាបំពេញមិនបានពេញលេញ។"

#: src/admin-kit/Support.js:560
msgid "Login address"
msgstr "អាសយដ្ឋានចូលប្រើ"

#: src/admin-kit/Support.js:571
msgid "Username"
msgstr "ឈ្មោះអ្នកប្រើប្រាស់"

#: src/admin-kit/Support.js:584
msgid "Password"
msgstr "ពាក្យសម្ងាត់"

#: src/admin-kit/Support.js:619
msgid "Add a login"
msgstr "បន្ថែមការចូលគណនី"

#: src/admin-kit/Support.js:626
msgid "Create a temporary support login"
msgstr "បង្កើតការចូលប្រើជំនួយបណ្តោះអាសន្ន"

#: src/admin-kit/Support.js:630
msgid "A separate user for our support team, without access to users, plugins installation or code editing. It is deleted automatically when it expires, or whenever you revoke it below."
msgstr "អ្នកប្រើប្រាស់ដាច់ដោយឡែកមួយសម្រាប់ក្រុមជំនួយបច្ចេកទេសរបស់យើង ដោយគ្មានសិទ្ធិចូលប្រើប្រាស់អ្នកប្រើប្រាស់ ការដំឡើងកម្មវិធីជំនួយ ឬការកែសម្រួលកូដឡើយ។ វាត្រូវបានលុបដោយស្វ័យប្រវត្តិនៅពេលផុតកំណត់ ឬនៅពេលណាដែលអ្នកដកហូតវាខាងក្រោម។"

#. translators: %d: number of days.
#: src/admin-kit/Support.js:645
#, js-format
msgid "Yes, for %d day"
msgid_plural "Yes, for %d days"
msgstr[0] "បាទ/ចាស សម្រាប់រយៈពេល %d ថ្ងៃ"

#: src/admin-kit/Support.js:669
msgid "Send"
msgstr "ផ្ញើ"

#: src/admin-kit/Support.js:694
msgid "The list could not be loaded."
msgstr "មិនអាចស្ទូចបញ្ជីបានទេ។"

#: src/admin-kit/Support.js:709
msgid "That login could not be removed."
msgstr "មិនអាចលុបការចូលប្រព័ន្ធនោះបានទេ។"

#: src/admin-kit/Support.js:721
msgid "Temporary support logins"
msgstr "ការចូលប្រើប្រាស់ជំនួយបណ្តោះអាសន្ន"

#: src/admin-kit/Support.js:733
msgid "None. Support can only log in to this site if you create a login here."
msgstr "គ្មាន។ ក្រុមការងារជំនួយអាចចូលទៅកាន់គេហទំព័រនេះបាន លុះត្រាតែអ្នកបង្កើតគណនីចូលទីនេះប៉ុណ្ណោះ។"

#: src/admin-kit/Support.js:745
msgid "expired, being removed"
msgstr "ផុតកំណត់ កំពុងលុបចេញ"

