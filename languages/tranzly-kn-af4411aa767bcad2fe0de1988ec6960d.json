            ],
            "This site receives beta versions as updates.": [
                "\u0c88 \u0cb8\u0cc8\u0c9f\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0ca3\u0c97\u0cb3\u0cbe\u0c97\u0cbf \u0cac\u0cc0\u0c9f\u0cbe \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
            ],
            "This site receives stable versions only.": [
                "\u0c88 \u0cb8\u0cc8\u0c9f\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0cb0 \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
            ],
            "Change this on the Account page": [
                "\u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u0cac\u0cc0\u0c9f\u0cbe \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb0\u0cc1\u0cb5 \u0caa\u0cb0\u0cb5\u0cbe\u0ca8\u0c97\u0cbf \u0caa\u0ca1\u0cc6\u0ca6 \u0caa\u0ccd\u0cb0\u0cca \u0c85\u0ca8\u0cc1\u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cca\u0c82\u0ca1 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6 \u0caa\u0cc1\u0c9f\u0ca6\u0cbf\u0c82\u0ca6 \u0cb8\u0cc7\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1."
