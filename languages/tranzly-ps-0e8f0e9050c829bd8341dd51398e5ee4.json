            "Engine for %s": [
                "\u062f %s \u0644\u067e\u0627\u0631\u0647 \u0627\u0646\u062c\u0646"
            ],
            "The default engine": [
                "\u0627\u0635\u0644\u064a \u0627\u0646\u062c\u0646"
            ],
            "If an engine fails or reaches a limit, try these next, in this order": [
                "\u06a9\u0647 \u06cc\u0648 \u0627\u0646\u06ab\u06cc\u0646 \u0646\u0627\u06a9\u0627\u0645 \u0634\u064a \u06cc\u0627 \u06a9\u0648\u0645 \u062d\u062f \u062a\u0647 \u0648\u0631\u0633\u06d0\u0696\u064a\u060c \u062f\u0627 \u0646\u0648\u0631 \u067e\u0647 \u062f\u06d0 \u062a\u0631\u062a\u06cc\u0628 \u0647\u0685\u0647 \u0648\u06a9\u0693\u0626"
            ],
            "Monthly spending caps": [
                "\u062f \u0645\u06cc\u0627\u0634\u062a\u0646\u064a \u0644\u06ab\u069a\u062a \u062d\u062f\u0648\u0646\u0647"
            ],
            "When an engine reaches its cap, nothing more is sent to it until next month and the failed-translation report says why. Leave empty for no cap.": [
                "\u06a9\u0644\u0647 \u0686\u06d0 \u06cc\u0648 \u0627\u0646\u062c\u0646 \u062e\u067e\u0644 \u062d\u062f \u062a\u0647 \u0648\u0631\u0633\u06cc\u0696\u064a\u060c \u062a\u0631 \u0628\u0644\u06d0 \u0645\u06cc\u0627\u0634\u062a\u06d0 \u067e\u0648\u0631\u06d0 \u0646\u0648\u0631 \u0647\u063a\u06d0 \u062a\u0647 \u0646\u0647 \u0627\u0633\u062a\u0648\u0644 \u06a9\u06cc\u0696\u064a \u0627\u0648 \u062f \u0646\u0627\u06a9\u0627\u0645\u06d0 \u0698\u0628\u0627\u0693\u06d0 \u0631\u0627\u067e\u0648\u0631 \u062f \u062f\u06d0 \u0644\u0627\u0645\u0644 \u0628\u06cc\u0627\u0646\u0648\u064a. \u062f \u062d\u062f \u0646\u0634\u062a\u0648\u0627\u0644\u064a \u0644\u067e\u0627\u0631\u0647 \u062e\u0627\u0644\u064a \u067e\u0631\u06cc\u0696\u062f\u0626."
            ],
            "%1$s (spent this month: $%2$s)": [
                "%1$s (\u062f \u062f\u06d0 \u0645\u06cc\u0627\u0634\u062a\u06d0 \u0644\u06ab\u069a\u062a: $%2$s)"
            ],
            "Save caps": [
                "\u0628\u0631\u062e\u06d0 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626"
            ],
            "Preferred translations (one per line: term = translation)": [
                "\u063a\u0648\u069a\u062a\u0644 \u0634\u0648\u06d0 \u0698\u0628\u0627\u0693\u06d0 (\u067e\u0647 \u0647\u0631\u0647 \u06a9\u0631\u069a\u0647 \u06a9\u06d0 \u06cc\u0648: term = translation)"
            ],
            "Formality": [
                "\u0631\u0633\u0645\u064a\u062a"
            ],
            "Default": [
                "\u067e\u062e\u067e\u0644\u0647"
            ],
            "Formal": [
                "\u0631\u0633\u0645\u064a"
            ],
            "Informal": [
                "\u063a\u06cc\u0631 \u0631\u0633\u0645\u06cc"
            ],
            "Style instructions (audience, brand voice)": [
                "\u062f \u0633\u067c\u0627\u06cc\u0644 \u0644\u0627\u0631\u069a\u0648\u0648\u0646\u06d0 (\u0644\u06cc\u062f\u0648\u0646\u06a9\u064a\u060c \u062f \u0628\u0631\u0627\u0646\u0689 \u063a\u0696)"
            ]
        }
    }
