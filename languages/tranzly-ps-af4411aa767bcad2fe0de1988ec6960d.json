            ],
            "Zinn Digital\u00ae website": [
                "\u062f Zinn Digital\u00ae \u0648\u06d0\u0628\u067e\u0627\u06bc\u0647"
            ],
            "Settings saved.": [
                "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u06d0."
            ],
            "See the Pro plans and pricing": [
                "\u062f Pro \u067e\u0644\u0627\u0646\u0648\u0646\u0647 \u0627\u0648 \u0646\u0631\u062e\u0648\u0646\u0647 \u0648\u06ab\u0648\u0631\u0626"
            ],
            "Languages": [
                "\u0698\u0628\u06d0"
            ],
            "The first language is the one your content is written in. Visitors switch with the language switcher block.": [
                "\u0644\u0648\u0645\u0693\u0646\u06cd \u0698\u0628\u0647 \u0647\u063a\u0647 \u062f\u0647 \u0686\u06d0 \u0633\u062a\u0627\u0633\u0648 \u0645\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u067e\u0631\u06d0 \u0644\u06cc\u06a9\u0644 \u0634\u0648\u06d0 \u062f\u0647. \u0644\u06cc\u062f\u0648\u0646\u06a9\u064a \u062f \u0698\u0628\u06d0 \u0628\u062f\u0644\u0648\u0644\u0648 \u0628\u0644\u0627\u06a9 \u067e\u0647 \u06a9\u0627\u0631\u0648\u0644\u0648 \u0633\u0631\u0647 \u0628\u062f\u0644\u0648\u0646 \u06a9\u0648\u064a."
            ],
            "(default)": [
                "(\u067e\u0646\u062f\u0631\u0647)"
            ],
            "Locale code": [
                "\u062f \u0633\u064a\u0645\u06d0 \u06a9\u0648\u0689"
            ],
            "For example fr_FR": [
                "\u062f \u0628\u06d0\u0644\u06ab\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 fr_FR"
            ],
            "Name (optional)": [
                "\u0646\u0648\u0645 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
            ],
            "For example Fran\u00e7ais": [
                "\u062f \u0628\u06d0\u0644\u06ab\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 Fran\u00e7ais"
            ],
            "Add language": [
                "\u0698\u0628\u0647 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0648\u0644"
            ],
            "Front-end output": [
                "\u062f \u0645\u062e\u06a9\u0646\u064a \u067e\u0627\u06cc \u067e\u0627\u06cc\u0644\u0647"
            ],
            "Class name prefix": [
                "\u062f \u067c\u0648\u0644\u06ab\u064a \u0646\u0648\u0645 \u0645\u062e\u062a\u0627\u0693\u06cc"
            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u062f \u067e\u0644\u06af \u0627\u0646 \u0644\u062e\u0648\u0627 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u067e\u0627\u06bc\u0648 \u06a9\u06d0 \u0686\u0627\u067e \u0634\u0648\u06cc \u062f \u067c\u0648\u0644\u06ab\u064a \u0646\u0648\u0645 \u062f \u062f\u06d0 \u0645\u062e\u062a\u0627\u0693\u064a \u0633\u0631\u0647 \u067e\u06cc\u0644 \u06a9\u06cc\u0696\u064a\u060c \u062a\u0631\u0685\u0648 \u067e\u0627\u06bc\u06d0 \u0685\u0631\u06ab\u0646\u062f\u06d0 \u0646\u06a9\u0693\u064a \u0686\u06d0 \u06a9\u0648\u0645 \u067e\u0644\u06af \u0627\u0646 \u062f\u0648\u06cc \u062c\u0648\u0693 \u06a9\u0693\u064a \u062f\u064a. \u0644\u0647 \u06f1 \u0685\u062e\u0647 \u062a\u0631 \u06f8 \u067e\u0648\u0631\u06d0 \u06a9\u0648\u0686\u0646\u064a \u062a\u0648\u0631\u064a \u06cc\u0627 \u0639\u062f\u062f\u0648\u0646\u0647\u060c \u0686\u06d0 \u067e\u0647 \u062a\u0648\u0631\u064a \u067e\u06cc\u0644 \u06a9\u06cc\u0696\u064a."
            ],
            "Beta updates": [
                "\u0622\u0632\u0645\u0627\u06cc\u069a\u062a\u064a \u062a\u0627\u0632\u0647 \u0645\u0639\u0644\u0648\u0645\u0627\u062a"
            ],
            "This site receives beta versions as updates.": [
                "\u062f\u0627 \u0633\u0627\u06cc\u067c \u062f \u062a\u0627\u0632\u0647 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0648 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u0628\u06cc\u067c\u0627 \u0646\u0633\u062e\u06d0 \u062a\u0631\u0644\u0627\u0633\u0647 \u06a9\u0648\u064a."
            ],
            "This site receives stable versions only.": [
                "\u062f\u0627 \u0633\u0627\u06cc\u067c \u06cc\u0648\u0627\u0632\u06d0 \u0628\u0627\u062b\u0628\u0627\u062a\u0647 \u0646\u0633\u062e\u06d0 \u062a\u0631\u0644\u0627\u0633\u0647 \u06a9\u0648\u064a."
            ],
            "Change this on the Account page": [
                "\u062f\u0627 \u062f \u062d\u0633\u0627\u0628 \u067e\u0647 \u067e\u0627\u06bc\u0647 \u06a9\u06d0 \u0628\u062f\u0644 \u06a9\u0693\u0626"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u062f \u0628\u06cc\u067c\u0627 \u0646\u0633\u062e\u06d0 \u0647\u063a\u0648 \u062c\u0648\u0627\u0632 \u0644\u0631\u0648\u0646\u06a9\u0648 \u067e\u0631\u0648 \u0627\u0646\u0633\u067c\u0627\u0644\u0634\u0646\u0648\u0646\u0648 \u062a\u0647 \u0648\u0693\u0627\u0646\u062f\u06d0 \u06a9\u06cc\u0696\u064a \u0686\u06d0 \u062f \u062f\u0648\u06cc \u0644\u0647 \u062d\u0633\u0627\u0628 \u0633\u0631\u0647 \u0648\u0635\u0644 \u062f\u064a. \u06cc\u0648\u0681\u0644 \u0686\u06d0 \u0648\u0635\u0644 \u0634\u0648\u060c \u062a\u0627\u0633\u0648 \u06a9\u0648\u0644\u06cc \u0634\u0626 \u062f \u062d\u0633\u0627\u0628 \u067e\u0627\u06bc\u06d0 \u0685\u062e\u0647 \u06ab\u0689\u0648\u0646 \u0648\u06a9\u0693\u0626."
            ],
            "Save settings": [
                "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0648\u0644"
            ]
        }
    }
