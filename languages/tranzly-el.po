msgstr "Δεν έχει μεταφραστεί ακόμα (αντίγραφο)"

#: src/editor/translations-panel.js:60
msgid "Save this post first, then translate it here."
msgstr "Αποθηκεύστε αυτήν τη δημοσίευση πρώτα και μετά μεταφράστε την εδώ."

#: src/editor/translations-panel.js:149
msgid "Side by side"
msgstr "Δίπλα-δίπλα"

#: src/editor/translations-panel.js:154
msgid "View"
msgstr "Προβολή"

#: src/editor/translations-panel.js:164
msgid "Unlock so it can be translated again"
msgstr "Ξεκλειδώστε ώστε να μπορέσει να μεταφραστεί ξανά"

#: src/editor/translations-panel.js:179
msgid "Protect"
msgstr "Προστασία"

#: src/editor/translations-panel.js:187
