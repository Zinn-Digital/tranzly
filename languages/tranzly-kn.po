msgstr "ಅನುವಾದಗಳನ್ನು ಪ್ರಕಟಿಸಿ (ಅಥವಾ ಅವುಗಳನ್ನು ಡ್ರಾಫ್ಟ್‌ಗಳಾಗಿ ಉಳಿಸಲಾಗುತ್ತದೆ)"

#: src/admin/Jobs.js:293
msgid "Estimate the cost"
msgstr "ವೆಚ್ಚವನ್ನು ಅಂದಾಜು ಮಾಡಿ"

#. translators: 1: number of posts, 2: characters.
#: src/admin/Jobs.js:300
#, js-format
msgid "%1$d posts, %2$s characters. The price for this engine is not known in advance."
msgstr "%1$d ಪೋಸ್ಟ್‌ಗಳು, %2$s ಅಕ್ಷರಗಳು. ಈ ಇಂಜಿನ್‌ನ ಬೆಲೆ ಮುಂಚಿತವಾಗಿ ತಿಳಿದಿಲ್ಲ."

#. translators: 1: number of posts, 2: characters, 3: an amount in US dollars.
#: src/admin/Jobs.js:309
#, js-format
msgid "%1$d posts, %2$s characters: about $%3$s on your own account."
msgstr "%1$d ಪೋಸ್ಟ್‌ಗಳು, %2$s ಅಕ್ಷರಗಳು: ನಿಮ್ಮ ಸ್ವಂತ ಖಾತೆಯಲ್ಲಿ ಸುಮಾರು $%3$s."

