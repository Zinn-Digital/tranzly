            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u092c\u0947\u091f\u093e \u0906\u0935\u0943\u0924\u094d\u0924\u094d\u092f\u093e \u092a\u0930\u0935\u093e\u0928\u093e\u0927\u093e\u0930\u0915 \u092a\u094d\u0930\u094b \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932\u0947\u0936\u0928\u0928\u093e \u0911\u092b\u0930 \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924 \u091c\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0936\u0940 \u091c\u094b\u0921\u0932\u0947\u0932\u0947 \u0905\u0938\u0924\u093e\u0924. \u090f\u0915\u0926\u093e \u091c\u094b\u0921\u0932\u0947 \u0915\u0940, \u0924\u0941\u092e\u094d\u0939\u0940 \u0916\u093e\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930\u0942\u0928 \u0938\u093e\u092e\u0940\u0932 \u0939\u094b\u090a \u0936\u0915\u0924\u093e."
            ],
            "Save settings": [
                "\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947\u0935\u094d\u0939 \u0915\u0930\u093e"
