#, js-format
msgid "Job started with %d translations to do. It runs in the background: you can close this page."
msgstr "%d மொழிபெயர்ப்புகளுடன் பணி தொடங்கப்பட்டது. இது பின்னணியில் இயங்குகிறது: இந்தப் பக்கத்தை நீங்கள் மூடலாம்."

#: src/admin/Jobs.js:170
msgid "Queued again."
msgstr "மீண்டும் வரிசையில் வைக்கப்பட்டது."

#: src/admin/Jobs.js:194
msgid "Running"
msgstr "இயங்குகிறது"

#: src/admin/Jobs.js:195
msgid "Finished"
msgstr "நிறைவடைந்தது"

#: src/admin/Jobs.js:211
msgid "Translate in the background"
msgstr "பின்னணியில் மொழிபெயர்"

#: src/admin/Jobs.js:216
msgid "Set up a translation engine in the Engines tab first."
msgstr "முதலில் எஞ்சின்கள் (Engines tab) தாவாவில் மொழிபெயர்ப்பு எஞ்சினை அமைக்கவும்."

#: src/admin/Jobs.js:225
msgid "Translate every"
msgstr "அனைத்தையும் மொழிபெயர்"

#: src/admin/Jobs.js:236
msgid "Into"
msgstr "உள்ளே"

#: src/admin/Jobs.js:264
msgid "With"
msgstr "உடன்"

#: src/admin/Jobs.js:269
msgid "Each language’s own engine"
msgstr "ஒவ்வொரு மொழியின் சொந்த இயந்திரம்"

#: src/admin/Jobs.js:285
msgid "Publish the translations (otherwise they are saved as drafts)"
msgstr "மொழிபெயர்ப்புகளை வெளியிடவும் (இல்லையெனில் அவை வரைவுகளாகச் சேமிக்கப்படும்)"

#: src/admin/Jobs.js:299
msgid "Estimate the cost"
msgstr "செலவை மதிப்பிடுங்கள்"

#. translators: 1: number of posts, 2: characters.
#: src/admin/Jobs.js:306
#, js-format
msgid "%1$d posts, %2$s characters. The price for this engine is not known in advance."
msgstr "%1$d பதிவுகள், %2$s எழுத்துகள். இந்த இன்ஜினின் விலை முன்பே அறியப்படவில்லை."

#. translators: 1: number of posts, 2: characters, 3: an amount in US dollars.
#: src/admin/Jobs.js:315
#, js-format
msgid "%1$d posts, %2$s characters: about $%3$s on your own account."
msgstr "%1$d பதிவுகள், %2$s எழுத்துகள்: உங்கள் சொந்தக் கணக்கில் தோராயமாக $%3$s."

#: src/admin/Jobs.js:333
msgid "Start translating"
msgstr "மொழிபெயர்க்கத் தொடங்குங்கள்"

#: src/admin/Jobs.js:339
msgid "Jobs"
msgstr "பணிகள்"

#: src/admin/Jobs.js:341
msgid "No translation jobs yet."
msgstr "இதுவரை மொழிபெயர்ப்புப் பணிகள் எதுவும் இல்லை."

#. translators: 1: job number, 2: job status.
#: src/admin/Jobs.js:349
#, js-format
msgid "Job %1$d — %2$s"
msgstr "பணி %1$d — %2$s"

#. translators: 1: translated, 2: total, 3: failed, 4: skipped.
#: src/admin/Jobs.js:356
#, js-format
msgid "%1$d of %2$d translated, %3$d failed, %4$d skipped (protected or already in that language)"
msgstr "%1$d இல் %2$d மொழிபெயர்க்கப்பட்டது, %3$d தோல்வியடைந்தது, %4$d தவிர்க்கப்பட்டது (பாதுகாக்கப்பட்டவை அல்லது ஏற்கனவே அந்த மொழியில் உள்ளவை)"

#: src/admin/Jobs.js:373
msgid "Stop this job"
msgstr "இந்தப் பணியை நிறுத்து"

#: src/admin/Jobs.js:381
msgid "See what failed and why"
msgstr "எது தோல்வியடைந்தது மற்றும் ஏன் என்பதைப் பார்க்கவும்"

#: src/admin/Jobs.js:395
msgid "Content"
msgstr "உள்ளடக்கம்"

#: src/admin/Jobs.js:398
msgid "Language"
msgstr "மொழி"

#: src/admin/Jobs.js:401
