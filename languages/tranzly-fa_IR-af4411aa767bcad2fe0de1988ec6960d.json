            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u0647\u0631 \u0646\u0627\u0645 \u06a9\u0644\u0627\u0633\u06cc \u06a9\u0647 \u0627\u0641\u0632\u0648\u0646\u0647 \u062f\u0631 \u0635\u0641\u062d\u0627\u062a \u0634\u0645\u0627 \u062f\u0631\u062c \u0645\u06cc\u200c\u06a9\u0646\u062f \u0628\u0627 \u0627\u06cc\u0646 \u067e\u06cc\u0634\u0648\u0646\u062f \u0622\u063a\u0627\u0632 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u0628\u0647 \u0637\u0648\u0631\u06cc \u06a9\u0647 \u0635\u0641\u062d\u0627\u062a \u0641\u0627\u0634 \u0646\u06a9\u0646\u0646\u062f \u06a9\u062f\u0627\u0645 \u0627\u0641\u0632\u0648\u0646\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0633\u0627\u062e\u062a\u0647 \u0627\u0633\u062a. \u06f1 \u062a\u0627 \u06f8 \u062d\u0631\u0641 \u06a9\u0648\u0686\u06a9 \u06cc\u0627 \u0631\u0642\u0645\u060c \u06a9\u0647 \u0628\u0627 \u06cc\u06a9 \u062d\u0631\u0641 \u0634\u0631\u0648\u0639 \u0645\u06cc\u200c\u0634\u0648\u062f."
            ],
            "Beta updates": [
                "\u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc\u200c\u0647\u0627\u06cc \u0628\u062a\u0627"
