msgid "Languages: %s"
msgstr "ພາສາ: %s"

#: src/admin/WorkflowTab.js:637
msgid "still active: switch it off first."
msgstr "ຍັງໃຊ້ງານຢູ່: ໃຫ້ປິດມັນກ່ອນ."

#: src/admin/WorkflowTab.js:649
