#: src/admin-kit/Support.js:751
#, js-format
msgid "expires %s"
msgstr "ផុតកំណត់ %s"

#: src/admin-kit/Support.js:764
msgid "Revoke now"
msgstr "ដកហូតសិទ្ធិឥឡូវនេះ"

