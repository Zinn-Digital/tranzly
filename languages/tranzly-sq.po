#. Plugin Name of the plugin
#: tranzly.php
#: includes/class-admin.php:55
#: includes/class-admin.php:56
#: includes/class-admin.php:75
msgid "Tranzly"
msgstr "Tranzly"

#. Plugin URI of the plugin
#: tranzly.php
msgid "https://zinndigital.com/wordpress-plugins/tranzly"
msgstr "https://zinndigital.com/wordpress-plugins/tranzly"

#. Description of the plugin
#: tranzly.php
msgid "Multilingual WordPress, one post per language: linked translations of posts, pages, categories, media text, widgets and the site title, with your old Tranzly translations imported."
msgstr "WordPress Shumëgjuhësh, një postim për çdo gjuhë: përkthime të lidhura të postimeve, faqeve, kategorive, tekstit të mediave, miniaplikacioneve dhe titullit të faqes, me përkthimet tuaja të vjetra të Tranzly të importuara."

#. Author of the plugin
#: tranzly.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: tranzly.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/ai-core/class-admin.php:59
#: includes/ai-core/class-admin.php:60
#: includes/ai-core/class-admin.php:118
msgid "AI providers"
msgstr "Ofruesit e AI"

#: includes/ai-core/class-admin.php:76
msgid "The makers of ChatGPT. A good all-rounder."
msgstr "Krijuesit e ChatGPT. Një zgjedhje e mirë e gjithanshme."

#: includes/ai-core/class-admin.php:78
msgid "The makers of Claude. Strong at writing and careful reasoning."
msgstr "Krijuesit e Claude. Të fortë në shkrim dhe në arsyetim të kujdesshëm."

#: includes/ai-core/class-admin.php:80
msgid "Google's Gemini models. Fast and inexpensive."
msgstr "Modelet Gemini të Google. Të shpejta dhe të lira."

#: includes/ai-core/class-admin.php:82
msgid "A European AI company with fast, inexpensive models."
msgstr "Një kompani evropiane e inteligjencës artificiale me modele të shpejta dhe të lira."

#: includes/ai-core/class-admin.php:84
msgid "Low-cost models that are good at writing and code."
msgstr "Modele me kosto të ulët që janë të mira në shkrim dhe kod."

#: includes/ai-core/class-admin.php:86
msgid "One key for models from many different providers."
msgstr "Një çelës për modele nga shumë ofrues të ndryshëm."

#: includes/ai-core/class-admin.php:88
msgid "Any service that works like OpenAI's API, including a model running on your own computer or server."
msgstr "Çdo shërbim që funksionon si API-ja e OpenAI, duke përfshirë një model që ekzekutohet në kompjuterin ose serverin tuaj."

#: includes/ai-core/class-admin.php:101
msgid "General (used when nothing more specific is set)"
msgstr "Të përgjithshme (përdoret kur nuk është caktuar ndonjë më specifik)"

#: includes/ai-core/class-admin.php:102
msgid "Writing and rewriting"
msgstr "Shkrim dhe rishkrim"

#: includes/ai-core/class-admin.php:103
#: src/compare/index.js:130
#: src/pro__premium_only/visual/index.js:24
msgid "Translation"
msgstr "Përkthimi"

#: includes/ai-core/class-admin.php:104
msgid "Code and CSS"
msgstr "Kodi dhe CSS"

#: includes/ai-core/class-admin.php:115
#: includes/class-admin.php:72
msgid "Sorry, you are not allowed to access this page."
msgstr "Na vjen keq, nuk ju lejohet të hyni në këtë faqe."

#. translators: %s: list of plugin names, e.g. "Tranzly, Page Builder Sandwich".
#: includes/ai-core/class-admin.php:128
#, php-format
msgid "These settings are shared by every plugin that uses them: %s."
msgstr "Këto cilësime ndahen nga çdo shtojcë që i përdor ato: %s."

#: includes/ai-core/class-admin.php:131
msgid "Your keys are encrypted in this site's database and are only ever sent to the provider you chose — never to us."
msgstr "Çelësat tuaj janë të enkoduar në bazën e të dhënave të kësaj faqeje dhe i dërgohen vetëm ofruesit që keni zgjedhur ju — kurrë tek ne."

#: includes/ai-core/class-admin.php:158
msgid "Step 1 of 2: choose an AI provider"
msgstr "Hapi 1 nga 2: zgjidhni një ofrues të AI"

#: includes/ai-core/class-admin.php:159
msgid "You bring your own key, so you pay the provider directly for what you use. Not sure? Any of these works well; you can add more later."
msgstr "Ju sillni çelësin tuaj, kështu që i paguani ofruesit direkt për atë që përdorni. Nuk jeni të sigurt? Secila prej këtyre funksionon mirë; mund të shtoni të tjera më vonë."

#: includes/ai-core/class-admin.php:169
#: includes/freemius-strings.php:1570
#: includes/freemius-strings.php:4586
msgid "Next"
msgstr "Para"

#. translators: %s: AI provider name.
#: includes/ai-core/class-admin.php:178
#, php-format
msgid "Step 2 of 2: connect %s"
msgstr "Hapi 2 nga 2: lidhni %s"

#: includes/ai-core/class-admin.php:183
msgid "Enter the address of your OpenAI-compatible service, ending in /v1. A key is only needed if the service asks for one."
msgstr "Vendosni adresën e shërbimit tuaj të pajtueshëm me OpenAI, që përfundon në /v1. Një çelës nevojitet vetëm nëse shërbimi kërkon një të tillë."

#. translators: %s: link to the provider's API key page.
#: includes/ai-core/class-admin.php:188
#, php-format
msgid "Open %s and sign in (or create a free account)."
msgstr "Hapni %s dhe hyni (ose krijoni një llogari falas)."

#. translators: %s: AI provider name.
#: includes/ai-core/class-admin.php:192
#, php-format
msgid "the %s API keys page"
msgstr "faqja e çelësave API %s"

#: includes/ai-core/class-admin.php:197
msgid "Create a new key and copy it."
msgstr "Krijo një çelës të ri dhe kopjoje atë."

#: includes/ai-core/class-admin.php:198
msgid "Paste it below and press \"Save and test\". We send one tiny request to check it works."
msgstr "Ngjite atë më poshtë dhe shtyp \"Ruaj dhe testo\". Ne dërgojmë një kërkesë të vogël për të kontrolluar se funksionon."

#. translators: %s: link to the provider's billing page.
#: includes/ai-core/class-admin.php:203
#, php-format
msgid "Most providers need a little credit on the account before a key works: %s."
msgstr "Shumë ofrues kanë nevojë për pak kredi në llogari përpara se një çelës të funksionojë: %s."

#: includes/ai-core/class-admin.php:204
msgid "add credit"
msgstr "shto kredi"

#: includes/ai-core/class-admin.php:209
msgid "← Choose a different provider"
msgstr "← Zgjidhni një ofrues tjetër"

#: includes/ai-core/class-admin.php:227
#: includes/freemius-strings.php:202
#: includes/freemius-strings.php:3187
msgid "Address"
msgstr "Adresa"

#. translators: %s: the last four characters of the saved key.
#: includes/ai-core/class-admin.php:231
#, php-format
msgid "Saved key ends in …%s — paste a new one to replace it"
msgstr "Çelësi i ruajtur përfundon në …%s — ngjitni një të ri për ta zëvendësuar"

#: includes/ai-core/class-admin.php:233
msgid "Key (optional)"
msgstr "Çelësi (opsionale)"

#: includes/ai-core/class-admin.php:233
msgid "API key"
msgstr "Çelësi i API-së"

#: includes/ai-core/class-admin.php:235
msgid "Save and test"
msgstr "Ruaj dhe provo"

#: includes/ai-core/class-admin.php:245
msgid "Providers"
msgstr "Ofruesit"

#: includes/ai-core/class-admin.php:246
#: includes/ai-core/class-admin.php:404
msgid "Provider"
msgstr "Ofruesi"

#: includes/ai-core/class-admin.php:246
msgid "Status"
msgstr "Statusi"

#: includes/ai-core/class-admin.php:246
#: includes/freemius-strings.php:1252
#: includes/freemius-strings.php:4347
msgid "Key"
msgstr "Çelësi"

#: includes/ai-core/class-admin.php:251
msgid "Get a key"
msgstr "Merr një çelës"

#: includes/ai-core/class-admin.php:256
msgid "Test"
msgstr "Test"

#: includes/ai-core/class-admin.php:257
#: includes/ai-core/class-admin.php:426
#: includes/freemius-strings.php:2132
#: includes/freemius-strings.php:4997
#: src/admin/App.js:147
msgid "Remove"
msgstr "Hiq"

#: includes/ai-core/class-admin.php:276
msgid "Saved by a newer plugin version: update this plugin, or enter the key again."
msgstr "Ruajtur nga një version më i ri i shtojcës: përditësoni këtë shtojcë ose futni sërish çelësin."

#: includes/ai-core/class-admin.php:278
msgid "The saved key can no longer be opened (the site's security keys changed). Enter it again."
msgstr "Çelësi i ruajtur nuk mund të hapet më (çelësat e sigurisë së faqes kanë ndryshuar). Futeni përsëri."

#: includes/ai-core/class-admin.php:281
msgid "Not connected"
msgstr "I lidhur"

#. translators: %s: date and time of the last successful test.
#: includes/ai-core/class-admin.php:287
#, php-format
msgid "Connected — last test passed %s"
msgstr "Lidhur — testimi i fundit kaloi %s"

#. translators: %s: why the last test failed.
#: includes/ai-core/class-admin.php:293
#, php-format
msgid "Last test failed: %s"
msgstr "Testi i fundit dështoi: %s"

#: includes/ai-core/class-admin.php:296
msgid "Connected — not tested yet"
msgstr "I lidhur — ende i paprovuar"

#: includes/ai-core/class-admin.php:305
msgid "Which model to use"
msgstr "Cilin model të përdoret"

#: includes/ai-core/class-admin.php:306
msgid "★ marks our recommendation for that task. The list includes every model your key can use, read live from the provider."
msgstr "★ shënon rekomandimin tonë për atë detyrë. Lista përfshin çdo model që çelësi juaj mund të përdorë, i lexuar drejtpërdrejt nga ofruesi."

#: includes/ai-core/class-admin.php:314
msgid "— Recommended for the provider —"
msgstr "— Rekomandohet për ofruesin —"

#: includes/ai-core/class-admin.php:334
msgid "Save models"
msgstr "Ruaj modelet"

#: includes/ai-core/class-admin.php:336
msgid "Refresh the model lists from the providers"
msgstr "Rifresko listat e modeleve nga furnizuesit"

#: includes/ai-core/class-admin.php:356
msgid "Images"
msgstr "Imazhet"

#: includes/ai-core/class-admin.php:358
msgid "Connect OpenAI or Google Gemini to make images."
msgstr "Lidhni OpenAI ose Google Gemini për të krijuar imazhe."

#: includes/ai-core/class-admin.php:362
msgid "— The newest image model of the first connected provider —"
msgstr "— Modeli më i ri i imazhit i ofruesit të parë të lidhur —"

#: includes/ai-core/class-admin.php:383
msgid "best quality"
msgstr "cilësia më e mirë"

#: includes/ai-core/class-admin.php:385
msgid "lowest cost"
msgstr "kosto më e ulët"

#: includes/ai-core/class-admin.php:387
msgid "fastest"
msgstr "më i shpejti"

#: includes/ai-core/class-admin.php:399
msgid "Add a model yourself"
msgstr "Shto një model vetë"

#: includes/ai-core/class-admin.php:400
msgid "A model came out today? Paste its exact name to use it straight away."
msgstr "Një model doli sot? Ngjitni emrin e tij të saktë për ta përdorur menjëherë."

#: includes/ai-core/class-admin.php:411
msgid "Model name"
msgstr "Emri i modelit"

#: includes/ai-core/class-admin.php:412
msgid "Add model"
msgstr "Shto model"

#: includes/ai-core/class-admin.php:442
msgid "Recommended models list"
msgstr "Lista e modeleve të rekomanduara"

#: includes/ai-core/class-admin.php:445
msgid "The recommended models list could not be verified, so no recommendations are shown. Reinstall the plugin, or turn on daily updates below."
msgstr "Lista e modeleve të rekomanduara nuk mund të verifikohej, ndaj nuk shfaqet asnjë rekomandim. Riinstaloni spin-in (plugin) ose aktivizoni përditësimet ditore më poshtë."

#. translators: %s: publication date.
#: includes/ai-core/class-admin.php:448
#, php-format
msgid "The list in use was published on %s. Each plugin update brings a fresh one."
msgstr "Lista në përdorim është publikuar më %s. Çdo përditësim i shtojcës sjell një të re."

#: includes/ai-core/class-admin.php:455
msgid "Also check Zinn Digital® once a day for an updated list."
msgstr "Gjithashtu kontrolloni Zinn Digital® një herë në ditë për një listë të përditësuar."

#: includes/ai-core/class-admin.php:456
msgid "Only a plain download request is sent: no key, no site address, nothing about your content. The list is signed, and a list that fails the signature check is ignored."
msgstr "Dërgohet vetëm një kërkesë e thjeshtë shkarkimi: asnjë çelës, asnjë adresë faqeje, asgjë rreth përmbajtjes suaj. Lista është e nënshkruar dhe një listë që dështon në kontrollin e nënshkrimit shpërfillet."

#. translators: 1: date and time, 2: result such as "updated".
#: includes/ai-core/class-admin.php:461
#, php-format
msgid "Last checked %1$s: %2$s."
msgstr "Kontrolluar për herë të fundit %1$s: %2$s."

#: includes/ai-core/class-admin.php:467
msgid "Save, and check now if turned on"
msgstr "Ruaje dhe kontrollo tani nëse është i aktivizuar"

#: includes/ai-core/class-admin.php:480
msgid "a newer list was installed"
msgstr "një listë më e re u instalua"

#: includes/ai-core/class-admin.php:482
msgid "already up to date"
msgstr "tashmë i përditësuar"

#: includes/ai-core/class-admin.php:484
msgid "the download failed the signature check and was ignored"
msgstr "shkarkimi dështoi në kontrollin e nënshkrimit dhe u ignorua"

#: includes/ai-core/class-admin.php:486
msgid "Zinn Digital® could not be reached; the current list stays in use"
msgstr "Zinn Digital® nuk mund të arrihej; lista aktuale mbetet në përdorim"

#: includes/ai-core/class-admin.php:489
msgid "turned off"
msgstr "fikur"

#: includes/ai-core/class-admin.php:526
#: src/admin/Jobs.js:432
msgid "Open"
msgstr "Hap"

#: includes/ai-core/class-admin.php:569
msgid "Check their status page"
msgstr "Kontrolloni faqen e tyre të statusit"

#: includes/ai-core/class-admin.php:572
msgid "Open your billing page"
msgstr "Hapni faqen tuaj të faturimit"

#: includes/ai-core/class-admin.php:574
msgid "Open your API keys page"
msgstr "Hapni faqen e çelësave tuaj API"

#: includes/ai-core/class-admin.php:577
msgid "Open the AI settings"
msgstr "Hape cilësimet e AI"

#: includes/ai-core/class-admin.php:588
#: includes/ai-core/pro__premium_only/class-pro-policy.php:296
msgid "Sorry, you are not allowed to do that."
msgstr "Më vjen keq, nuk ju lejohet ta bëni këtë."

#: includes/ai-core/class-admin.php:614
#: includes/ai-core/class-admin.php:648
msgid "Unknown provider."
msgstr "Ofrues i panjohur."

#: includes/ai-core/class-admin.php:622
msgid "Enter the address of your service, for example http://localhost:11434/v1."
msgstr "Vendosni adresën e shërbimit tuaj, për shembull http://localhost:11434/v1."

#: includes/ai-core/class-admin.php:629
msgid "That does not look like an API key. Copy it again, without spaces."
msgstr "Kjo nuk duket si një çelës API. Kopjoje përsëri, pa hapësira."

#: includes/ai-core/class-admin.php:633
msgid "Paste your API key first."
msgstr "Ngjitni çelësin tuaj të API-së së pari."

#: includes/ai-core/class-admin.php:697
msgid "Key removed."
msgstr "Çelësi u hoq."

#: includes/ai-core/class-admin.php:734
msgid "Models saved."
msgstr "Modelet u ruajtën."

#: includes/ai-core/class-admin.php:748
msgid "Enter the model's exact name, for example as the provider's documentation writes it."
msgstr "Futni emrin e saktë të modelit, për shembull siç shkruhet në dokumentacionin e ofruesit."

#. translators: %s: model name.
#: includes/ai-core/class-admin.php:772
#, php-format
msgid "Added %s. Choose it under \"Which model to use\"."
msgstr "U shtua %s. Zgjidhni atë te \"Cilin model të përdorni\"."

#: includes/ai-core/class-admin.php:801
msgid "Model removed."
msgstr "Modeli u hoq."

#: includes/ai-core/class-admin.php:828
msgid "Daily updates are off. The list that came with the plugin is used."
msgstr "Përditësimet ditore janë të çaktivizuara. Përdoret lista që erdhi me shtojcën."

#. translators: %s: result of the check, such as "already up to date".
#: includes/ai-core/class-admin.php:835
#, php-format
msgid "Checked: %s."
msgstr "Ikontrolluar: %s."

#: includes/ai-core/class-admin.php:857
msgid "Model lists refreshed."
msgstr "Listat e modeleve u freskuan."

#: includes/ai-core/class-client.php:53
msgid "Your AI key was saved by a newer version of one of your plugins. Update this plugin, or enter the key again in the AI settings."
msgstr "Çelësi juaj i AI u ruajt nga një version më i ri i njërit prej shtojcave tuaja. Përditësoni këtë shtojcë, ose futeni sërish çelësin te cilësimet e AI."

#: includes/ai-core/class-client.php:54
msgid "Your saved AI key can no longer be opened (the site's security keys changed). Enter it again in the AI settings."
msgstr "Çelësi juaj i ruajtur i AI-së nuk mund të hapet më (çelësat e sigurisë së faqes kanë ndryshuar). Futeni përsëri te cilësimet e AI-së."

#: includes/ai-core/class-client.php:59
msgid "AI is not set up yet. Add a key for an AI provider in the AI settings."
msgstr "AI nuk është konfiguruar ende. Shtoni një çelës për një ofrues AI në cilësimet e AI."

#: includes/ai-core/class-client.php:65
msgid "No model is chosen for this task. Pick one in the AI settings."
msgstr "Asnjë model nuk është zgjedhur për këtë detyrë. Zgjidhni një te cilësimet e AI."

#: includes/ai-core/class-client.php:87
msgid "That AI provider is not supported by this version of the plugin."
msgstr "Ky ofrues i AI nuk mbështetet nga ky version i shtojcës."

#: includes/ai-core/class-client.php:125
msgid "No AI provider that can make images is connected. Add an OpenAI or Google Gemini key in the AI settings."
msgstr "Nuk është lidhur asnjë ofrues i AI që mund të gjenerojë imazhe. Shtoni një çelës të OpenAI ose Google Gemini te cilësimet e AI."

#: includes/ai-core/class-client.php:129
#: includes/ai-core/class-provider.php:295
msgid "This AI provider cannot make images. Choose OpenAI or Google Gemini for images in the AI settings."
msgstr "Ky ofrues i AI-së nuk mund të krijojë imazhe. Zgjidhni OpenAI ose Google Gemini për imazhet te cilësimet e AI-së."

#: includes/ai-core/class-client.php:135
msgid "Your AI key cannot use any image model. Check the key's permissions with the provider, or choose another provider for images."
msgstr "Çelësi juaj i AI-së nuk mund të përdorë asnjë model imazhi. Kontrolloni lejet e çelësit te ofruesi, ose zgjidhni një ofrues tjetër për imazhet."

#: includes/ai-core/class-failure.php:141
msgid "This site could not reach your AI service. Check that it is running and that its address is reachable from your web server (a service on your own computer is not reachable from a hosted site)."
msgstr "Kjo faqe nuk mundi të arrinte te shërbimi juaj i AI. Kontrolloni që ai është duke punuar dhe se adresa e tij është e arritshme nga serveri juaj i uebit (një shërbim në kompjuterin tuaj nuk është i arritshëm nga një faqe e pritur në host)."

#. translators: %s: AI provider name, e.g. OpenAI.
#: includes/ai-core/class-failure.php:152
#, php-format
msgid "This site could not reach %s. Check their status page; if they are up, your host may be blocking outgoing connections, or the address is wrong."
msgstr "Kjo faqe nuk mundi të arrinte te %s. Kontrolloni faqen e tyre të statusit; nëse ata janë aktivë, strehuesi juaj mund të jetë duke bllokuar lidhjet dalëse, ose adresa është e gabuar."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:168
#, php-format
msgid "%s says your account has no credit or quota left. Add credit or raise your limit in your account with them, then try again."
msgstr "%s thotë se llogaria juaj nuk ka më asnjë kredi apo kuotë të mbetur. Shtoni kredi ose rritni kufirin tuaj në llogarinë tuaj me ta, pastaj provoni përsëri."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:182
#, php-format
msgid "%s did not accept your key. It may be mistyped, revoked or expired. Create a new key and paste it here."
msgstr "%s nuk e pranoi çelësin tuaj. Mund të jetë shkruar gabim, i revokuar ose i skaduar. Krijoni një çelës të ri dhe ngjiteni këtu."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:196
#, php-format
msgid "%s refused this request for your key. The key may not have access to this model or feature, or your account needs verifying."
msgstr "%s refuzoi këtë kërkesë për çelësin tuaj. Çelësi mund të mos ketë qasje në këtë model ose funksionalitet, ose llogaria juaj ka nevojë për verifikim."

#. translators: 1: model name, 2: AI provider name.
#: includes/ai-core/class-failure.php:210
#, php-format
msgid "The model \"%1$s\" is not available from %2$s for your key. Choose another model in the AI settings."
msgstr "Modeli \"%1$s\" nuk është i disponueshëm nga %2$s për çelësin tuaj. Zgjidhni një model tjetër te cilësimet e AI."

#. translators: 1: model name, 2: AI provider name.
#: includes/ai-core/class-failure.php:227
#, php-format
msgid "Your %2$s plan does not include the model \"%1$s\". Choose another model in the AI settings, or upgrade your plan with them."
msgstr "Pani Jau %2$s nuk përfshin modelin \"%1$s\". Zgjidhni një model tjetër te cilësimet e AI, ose përmirësoni planin tuaj me ta."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:242
#, php-format
msgid "%s is limiting how fast your key can send requests. Wait a minute and try again, or raise your rate limit with them."
msgstr "%s po kufizon shpejtësinë me të cilën çelësi juaj mund të dërgojë kërkesa. Prisni një minutë dhe provoni përsëri, ose rritni kufirin tuaj të shpejtësisë me ta."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:256
#, php-format
msgid "%s is having problems right now (an outage or overload on their side). Nothing is wrong with your settings. Try again shortly."
