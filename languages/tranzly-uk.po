msgstr "Спочатку збережіть цей допис, а потім перекладіть його тут."

#: src/editor/translations-panel.js:148
msgid "Side by side"
msgstr "Пліч-о-пліч"

#: src/editor/translations-panel.js:153
msgid "View"
msgstr "Переглянути"

#: src/editor/translations-panel.js:161
