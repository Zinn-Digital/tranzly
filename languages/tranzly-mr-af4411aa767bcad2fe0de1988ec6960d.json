            ],
            "Tranzly calls the translation services with your own account. Keys are stored encrypted in your database and are only ever sent to the service they belong to. AI model keys are set in the AI settings.": [
                "Tranzly \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0938\u0939 \u092d\u093e\u0937\u093e\u0902\u0924\u0930 \u0938\u0947\u0935\u093e\u0902\u0928\u093e \u0915\u0949\u0932 \u0915\u0930\u0924\u0947. \u0915\u0940\u091c \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u094d\u092f\u0947 \u090f\u0928\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0938\u094d\u0935\u0930\u0942\u092a\u093e\u0924 \u0938\u093e\u0920\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e \u092b\u0915\u094d\u0924 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u0947\u0935\u0947\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924. AI \u092e\u0949\u0921\u0947\u0932 \u0915\u0940\u091c AI \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c\u092e\u0927\u094d\u092f\u0947 \u0938\u0947\u091f \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924."
            ],
            "%s API key": [
                "%s API \u0915\u0940"
            ],
            "Saved: %s. Enter a new key to replace it, or save an empty field to remove it.": [
                "\u091c\u0924\u0928 \u0915\u0947\u0932\u0947: %s. \u0924\u0947 \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u0935\u0940\u0928 \u0915\u0940 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e, \u0915\u093f\u0902\u0935\u093e \u0924\u0947 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0930\u093f\u0915\u093e\u092e\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u091c\u0924\u0928 \u0915\u0930\u093e."
            ],
