            "Choose the AI model that translates each language, for example one model for Japanese and another for German. Languages without a choice of their own use the model for all other languages.": [
                "\u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u0630\u064a \u064a\u062a\u0631\u062c\u0645 \u0643\u0644 \u0644\u063a\u0629\u060c \u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0646\u0645\u0648\u0630\u062c \u0648\u0627\u062d\u062f \u0644\u0644\u064a\u0627\u0628\u0627\u0646\u064a\u0629 \u0648\u0622\u062e\u0631 \u0644\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629. \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u064a\u0633 \u0644\u0647\u0627 \u062e\u064a\u0627\u0631 \u062e\u0627\u0635 \u0628\u0647\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062e\u0635\u0635 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649."
            ],
            "AI model for all other languages": [
