            ],
            "AI provider %1$s, every language it translates (spent this month: $%2$s)": [
                "AI \u092a\u094d\u0930\u0926\u093e\u092f\u0915 %1$s, \u092f\u0938\u0932\u0947 \u0905\u0928\u0941\u0935\u093e\u0926 \u0917\u0930\u094d\u0928\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092d\u093e\u0937\u093e (\u092f\u0938 \u092e\u0939\u093f\u0928\u093e \u0916\u0930\u094d\u091a \u092d\u090f\u0915\u094b: $%2$s)"
