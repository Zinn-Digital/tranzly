msgstr "Δεν έχει μεταφραστεί"

#: src/editor/translations-model.js:29
msgid "Original"
msgstr "Πρωτότυπο"

#: src/editor/translations-model.js:33
msgid "Published"
msgstr "Δημοσιευμένο"

#: src/editor/translations-model.js:34
msgid "Draft"
msgstr "Πρόχειρο"

#: src/editor/translations-model.js:36
msgid "Checked by a person, protected"
msgstr "Ελέγχθηκε από άνθρωπο, προστατευμένο"

#: src/editor/translations-model.js:37
msgid "Imported, protected"
msgstr "Εισηγμένα, προστατευμένα"

#: src/editor/translations-model.js:39
