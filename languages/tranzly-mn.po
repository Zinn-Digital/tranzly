#: src/pro__premium_only/visual/index.js:19
#: src/pro__premium_only/visual/index.js:22
msgid "Correct this translation"
msgstr "Энэ орчуулгыг засах"

#: src/pro__premium_only/visual/index.js:48
msgid "Saving…"
msgstr "Хадгалж байна…"

#: src/pro__premium_only/visual/index.js:76
msgid "Translated text. Press Enter to correct it."
msgstr "Орчуулсан текст. Засварлахын тулд Enter дарна уу."

#: src/pro__premium_only/visual/index.js:105
