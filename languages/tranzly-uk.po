#: src/pro__premium_only/visual/index.js:101
msgid "No translated text was found on this page to edit here. Use the side-by-side editor instead."
msgstr "На цій сторінці не знайдено перекладеного тексту для редагування. Натомість скористайтеся редактором із паралельним переглядом."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Перемикач мови"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Посилання на цю сторінку кожною мовою сайту. Він нічого не відображає, доки не вказано дві або більше мов."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Мова"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "перемикач"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "переклад"

#. zinn-i18n: human translation — the machine translator refused this string
#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Дає відвідувачам змогу читати цю сторінку іншою з ваших мов: список, плашки, кнопки, випадний список або коди мов, за бажанням із прапорцями."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "багатомовний"
