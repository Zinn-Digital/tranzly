#: src/admin/WorkflowTab.js:109
msgid "When an original changes"
msgstr "នៅពេលដែលដើមផ្លាស់ប្តូរ"

#: src/admin/WorkflowTab.js:114
msgid "When a page is edited"
msgstr "នៅពេលដែលទំព័រមួយត្រូវបានកែសម្រួល"

#: src/admin/WorkflowTab.js:119
msgid "Mark its translations out of date"
msgstr "សម្គាល់ការបកប្រែរបស់វាថាអស់សុពលភាព"

