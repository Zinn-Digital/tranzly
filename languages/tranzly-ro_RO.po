msgstr "%s a refuzat această solicitare pentru cheia dumneavoastră. Este posibil ca cheia să nu aibă acces la acest model sau la această funcție, sau contul dumneavoastră necesită verificare."

#. translators: 1: model name, 2: AI provider name.
#: includes/ai-core/class-failure.php:210
#, php-format
msgid "The model \"%1$s\" is not available from %2$s for your key. Choose another model in the AI settings."
msgstr "Modelul \"%1$s\" nu este disponibil de la %2$s pentru cheia dumneavoastră. Alegeți alt model în setările AI."

#. translators: 1: model name, 2: AI provider name.
#: includes/ai-core/class-failure.php:227
#, php-format
msgid "Your %2$s plan does not include the model \"%1$s\". Choose another model in the AI settings, or upgrade your plan with them."
msgstr "Planul dvs. %2$s nu include modelul „%1$s”. Alegeți un alt model din setările AI sau faceți upgrade la planul dvs. împreună cu aceștia."

#. translators: %s: AI provider name.
#: includes/ai-core/class-failure.php:242
#, php-format
