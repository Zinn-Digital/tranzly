            "Not translated yet": [
                "\u062a\u0631 \u0627\u0648\u0633\u0647 \u0646\u0647 \u062f\u06cc \u0698\u0628\u0627\u0693\u0644 \u0634\u0648\u06cc"
            ],
            "Saved. The pieces you changed are marked as checked by a person, and this translation is protected from machine translation.": [
                "\u062e\u0648\u0646\u062f\u064a \u0634\u0648. \u0647\u063a\u0647 \u0628\u0631\u062e\u06d0 \u0686\u06d0 \u062a\u0627\u0633\u0648 \u0628\u062f\u0644\u06d0 \u06a9\u0693\u06d0 \u062f \u06cc\u0648 \u06a9\u0633 \u0644\u062e\u0648\u0627 \u062f \u06a9\u062a\u0644 \u0634\u0648\u06cc\u0648 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u0646\u069a\u0647 \u0634\u0648\u06d0 \u062f\u064a\u060c \u0627\u0648 \u062f\u0627 \u0698\u0628\u0627\u0693\u0647 \u062f \u0645\u0627\u0634\u06cc\u0646\u064a \u0698\u0628\u0627\u0693\u06d0 \u0685\u062e\u0647 \u062e\u0648\u0646\u062f\u064a \u062f\u0647."
            ],
            "The layout of this translation was changed in the editor, so some pieces no longer pair with the original. Pieces without a partner are shown empty; edit the rest in the editor.": [
                "\u062f \u062f\u06d0 \u0698\u0628\u0627\u0693\u06d0 \u0628\u06bc\u0647 \u067e\u0647 \u0627\u06cc\u0689\u06cc\u067c\u0631 \u06a9\u06d0 \u0628\u062f\u0644\u0647 \u0634\u0648\u06d0\u060c \u0646\u0648 \u0681\u06cc\u0646\u06d0 \u0628\u0631\u062e\u06d0 \u0646\u0648\u0631 \u0644\u0647 \u0627\u0635\u0644\u064a \u0633\u0631\u0647 \u0646\u0647 \u062c\u0648\u0693\u06d0\u0696\u064a. \u0647\u063a\u0647 \u0628\u0631\u062e\u06d0 \u0686\u06d0 \u062c\u0648\u0693\u0647 \u0646\u0647 \u0644\u0631\u064a \u062e\u0627\u0644\u064a \u069a\u0648\u062f\u0644 \u06a9\u06d0\u0696\u064a\u061b \u067e\u0627\u062a\u06d0 \u0628\u0631\u062e\u0647 \u067e\u0647 \u0627\u06cc\u0689\u06cc\u067c\u0631 \u06a9\u06d0 \u0633\u0645 \u06a9\u0693\u0626."
            ],
            "Open the editor": [
                "\u0627\u06cc\u0689\u06cc\u067c\u0631 \u067e\u0631\u0627\u0646\u06cc\u0632\u0626"
            ],
            "Original (%s)": [
                "\u0627\u0635\u0644\u064a (%s)"
            ],
            "Translation (%s)": [
                "\u0698\u0628\u0627\u0693\u0647 (%s)"
            ],
            "This piece has formatting or links, so it is shown with its HTML. Change only the words between the tags.": [
                "\u062f\u0627 \u0628\u0631\u062e\u0647 \u0628\u06bc\u0647 \u06cc\u0627 \u0644\u06cc\u0646\u06a9\u0648\u0646\u0647 \u0644\u0631\u064a\u060c \u0646\u0648 \u062f\u0627 \u062f \u062e\u067e\u0644 HTML \u0633\u0631\u0647 \u069a\u0648\u062f\u0644 \u06a9\u06cc\u0696\u064a. \u06cc\u0648\u0627\u0632\u06d0 \u062f \u067c\u06ab\u0648\u0646\u0648 \u062a\u0631\u0645\u0646\u0681 \u067c\u06a9\u064a \u0628\u062f\u0644 \u06a9\u0693\u0626."
            ],
            "Save changes": [
                "\u0628\u062f\u0644\u0648\u0646\u0648\u0646\u0647 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626"
            ],
            "Open in the editor": [
                "\u067e\u0647 \u0627\u06cc\u0689\u06cc\u067c\u0631 \u06a9\u06d0 \u067e\u0631\u0627\u0646\u06cc\u0633\u062a\u0644"
            ],
            "Checked by a person": [
                "\u062f \u06cc\u0648 \u06a9\u0633 \u0644\u062e\u0648\u0627 \u06a9\u062a\u0644 \u0634\u0648\u06cc"
            ],
