msgstr "என்ன தவறு நடந்தது"

#: src/admin/Jobs.js:407
msgid "Fix it"
msgstr "சரிசெய்"

#: src/admin/Jobs.js:456
msgid "Retry with"
msgstr "இதனுடன் மீண்டும் முயற்சிக்கவும்"

#: src/admin/Jobs.js:468
msgid "The same engine"
msgstr "அதே இயந்திரம்"

#: src/admin/Jobs.js:496
msgid "Retry"
msgstr "மீண்டும் முயற்சிக்கவும்"

#: src/admin/Jobs.js:507
msgid "Translate by hand"
msgstr "கையால் மொழிபெயர்"

#: src/admin/Root.js:23
msgid "Languages and settings"
msgstr "மொழிகள் மற்றும் அமைப்புகள்"

#: src/admin/Root.js:25
