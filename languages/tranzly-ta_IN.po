msgstr "மீண்டும் மொழிபெயர்க்கும் வகையில் திறக்கவும்"

#: src/editor/translations-panel.js:179
msgid "Protect"
msgstr "பாதுகாக்கவும்"

#: src/editor/translations-panel.js:187
msgid "Publish the translations"
msgstr "மொழிபெயர்ப்புகளை வெளியிடுக"

