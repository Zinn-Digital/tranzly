msgid "Step %1$d of %2$d: %3$s"
msgstr "ຂັ້ນຕອນ %1$d ຈາກ %2$d: %3$s"

#: src/admin-kit/Wizard.js:119
msgid "Finish"
msgstr "ສໍາເລັດແລ້ວ"

