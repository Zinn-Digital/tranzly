#: includes/seo/class-url-settings.php:129
msgid "Choose how languages appear in your addresses: a folder, a subdomain, a separate domain or a query parameter."
msgstr "ເລືອກວິທີການສະແດງພາສາໃນທີ່ຢູ່ເວັບໄຊຂອງທ່ານ: ເປັນໂຟນເດີ, ເປັນຊັບໂດເມນ, ເປັນໂດເມນແຍກຕ່າງຫາກ ຫຼື ເປັນພາລາມິເຕີຄຳຖາມ."

#: includes/seo/class-url-settings.php:132
#: src/admin/Urls.js:115
msgid "Subdomains and separate domains per language are part of Tranzly Pro."
msgstr "subdomains ແລະ domains ແຍກຕ່າງຫາກສຳລັບແຕ່ລະພາສາແມ່ນສ່ວນໜຶ່ງຂອງ Tranzly Pro."

#: includes/seo/class-url-settings.php:139
msgid "The language folders must be a list."
msgstr "ໂຟນເດີພາສາຕ້ອງເປັນລາຍການ."

#. translators: %s: the folder name that was refused.
#: includes/seo/class-url-settings.php:148
#, php-format
msgid "\"%s\" cannot be a language folder. Use 2 to 12 lowercase letters, digits or hyphens, different for every language, and not a word WordPress already uses."
msgstr "\"%s\" ບໍ່ສາມາດເປັນໂຟນເດີພາສາໄດ້. ໃຫ້ໃຊ້ຕົວອັກສອນພິມນ້ອຍ, ຕົວເລກ ຫຼື ເຄື່ອງໝາຍຂີດກາງ 2 ເຖິງ 12 ໂຕ, ແຕກຕ່າງກັນສຳລັບແຕ່ລະພາສາ, ແລະ ບໍ່ແມ່ນຄຳທີ່ WordPress ນຳໃຊ້ຢູ່ແລ້ວ."

#: includes/seo/class-url-settings.php:158
msgid "The domains must be a list."
msgstr "ໂດເມນຕ່າງໆຕ້ອງເປັນລາຍການ."

#. translators: %s: the domain that was refused.
#: includes/seo/class-url-settings.php:169
#, php-format
msgid "\"%s\" is not a domain name, such as example.de."
msgstr "\"%s\" ບໍ່ແມ່ນຊື່ໂດເມນ, ເຊັ່ນ example.de."

#: includes/seo/class-url-settings.php:174
msgid "Each language needs its own domain."
msgstr "ແຕ່ລະພາສາຈຳເປັນຕ້ອງມີໂດເມນຂອງຕົນເອງ."

#: includes/seo/class-url-settings.php:181
msgid "The translated address words must be a list."
msgstr "ຄຳສັບທີ່ຢູ່ທີ່ແປແລ້ວຕ້ອງເປັນລາຍການ."

#: includes/seo/class-url-settings.php:187
msgid "The translated address words must be listed per language."
msgstr "ຄຳສັບທີ່ຢູ່ທີ່ແປແລ້ວຕ້ອງຖືກລະບຸຕາມແຕ່ລະພາສາ."

#. translators: %s: the address word that was refused.
#: includes/seo/class-url-settings.php:196
#, php-format
msgid "\"%s\" cannot be used in an address. Use lowercase letters, digits and hyphens."
msgstr "\"%s\" ບໍ່ສາມາດໃຊ້ໃນທີ່ຢູ່ໄດ້. ໃຫ້ໃຊ້ຕົວອັກສອນພິມນ້ອຍ, ຕົວເລກ ແລະ ເຄື່ອງໝາຍຂີດກາງ."

#: includes/seo/class-url-settings.php:207
msgid "This setting is on or off."
msgstr "ການຕັ້ງຄ່ານີ້ແມ່ນເປີດ ຫຼື ປິດ."

#: includes/seo/class-url-settings.php:210
msgid "Hiding untranslated pages from search engines is part of Tranzly Pro."
msgstr "ການເຊື່ອງໜ້າເວັບທີ່ຍັງບໍ່ທັນໄດ້ແປຈາກເຄື່ອງມືຊອກຫາແມ່ນສ່ວນໜຶ່ງຂອງ Tranzly Pro."

