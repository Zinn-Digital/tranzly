#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "ಭಾಷಾ ಬದಲಾಯಿಸುವ ಸಾಧನ"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "ಸೈಟ್‌ನ ಪ್ರತಿಯೊಂದು ಭಾಷೆಯಲ್ಲಿಯೂ ಈ ಪುಟಕ್ಕೆ ಲಿಂಕ್‌ಗಳು. ಎರಡೋ ಅಥವಾ ಹೆಚ್ಚಿನ ಭಾಷೆಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುವವರೆಗೆ ಇದು ಏನನ್ನೂ ಪ್ರದರ್ಶಿಸುವುದಿಲ್ಲ."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ಭಾಷೆ"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "ಸ್ವಿಚರ್"

