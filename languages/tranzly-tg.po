#: src/editor/translations-panel.js:217
#, js-format
msgid "%s: translated."
msgstr "%s: тарҷума шуд."

#: src/editor/visibility.js:57
msgid "Show this block"
msgstr "Намоиш додани ин блок"

#: src/editor/visibility.js:62
msgid "In every language"
msgstr "Дар ҳар як забон"

#: src/editor/visibility.js:66
msgid "Only in the languages ticked"
msgstr "Фақат бо забонҳои қайдшуда"

#: src/editor/visibility.js:73
msgid "In every language except those ticked"
msgstr "Дар ҳамаи забонҳо ба истиснои онҳое, ки қайд шудаанд"

#: src/pro__premium_only/editor/index.js:48
msgid "Image per language"
msgstr "Тасвир барои ҳар як забон"

#: src/pro__premium_only/editor/index.js:52
msgid "Show another image to readers of a language, for example a banner with words on it."
msgstr "Барои хонандагони як забон тасвири дигарро нишон диҳед, масалан, баннер бо навиштаҷот дар он."

#. translators: %s: a language's name.
#: src/pro__premium_only/editor/index.js:88
#, js-format
msgid "Replace the %s image"
msgstr "Иваз кардани тасвири %s"

#. translators: %s: a language's name.
#: src/pro__premium_only/editor/index.js:96
#, js-format
msgid "Choose a %s image"
msgstr "Тасвири %s-ро интихоб кунед"

#: src/pro__premium_only/editor/index.js:120
msgid "Use the original image"
msgstr "Акси аслӣ истифода шавад"

#: src/pro__premium_only/visual/index.js:19
#: src/pro__premium_only/visual/index.js:22
msgid "Correct this translation"
msgstr "Ин тарҷумаро ислоҳ кунед"

#: src/pro__premium_only/visual/index.js:48
msgid "Saving…"
msgstr "Захира карда истодааст..."

#: src/pro__premium_only/visual/index.js:76
msgid "Translated text. Press Enter to correct it."
msgstr "Матни тарҷумашуда. Барои ислоҳ кардани он тугмаи Enter-ро пахш кунед."

#: src/pro__premium_only/visual/index.js:105
msgid "Click any outlined text to correct its translation."
msgstr "Барои ислоҳи тарҷумаи он ба ҳар гуна матни гирдогирд иҳоташуда клик кунед."

#: src/pro__premium_only/visual/index.js:109
msgid "No translated text was found on this page to edit here. Use the side-by-side editor instead."
msgstr "Дар ин саҳифа ягон матни тарҷумашуда барои таҳрир дар ин ҷо ёфт нашуд. Ба ҷои ин, аз муҳаррири паҳлӯ ба паҳлӯ истифода баред."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Ивазкунандаи забон"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Links to this page in each of the site's languages. It renders nothing until two or more languages are listed."
msgstr "Истинодҳо ба ин саҳифа бо ҳар як забони сайт. То замоне ки ду ё зиёда забон номбар нашаванд, он чизеро намоиш намедиҳад."

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Забон"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "Ивазкунанда"

#: blocks/fixture-switcher/block.json
#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "тарҷума"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another of your languages: a list, pills, buttons, a dropdown or language codes, with optional flags."
msgstr "Ба меҳмонон имкон медиҳад, ки ин саҳифаро бо дигар забонҳои шумо хонанд: рӯйхат, нишонаҳо (pills), тугмаҳо, рӯйхати афшон ё рамзҳои забонҳо бо парчамҳои ихтиёрӣ."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "серҷаҳонӣ"
